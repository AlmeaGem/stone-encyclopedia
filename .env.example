# Preview remains noindex until public launch is explicitly enabled.
SITE_URL=https://YOUR-NEW-PROJECT.pages.dev
BASE_PATH=/
PUBLIC_LAUNCH=false
# Optional, independent analytics. Never use Manager credentials.
PUBLIC_ANALYTICS_DOMAIN=
# Local/private editor only. Set a unique 20+ character passphrase locally.
EDITOR_PASSWORD=
EDITOR_PORT=4322
# Optional HTTPS public photo service origin (no secrets). Enable only after Access/R2/D1 deployment.
PUBLIC_PHOTO_API_ORIGIN=
