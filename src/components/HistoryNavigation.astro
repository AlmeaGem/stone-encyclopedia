---
import { pathTo } from '../lib/urls';
---

<nav
  class="history-navigation"
  aria-label="閲覧履歴の移動"
  data-history-base={pathTo()}
>
  <button type="button" data-history-direction="-1" disabled>
    <span class="arrow" aria-hidden="true">
      ←
    </span>{' '}
    <span>
      前のページ<span class="desktop-label">へ戻る</span>
    </span>
  </button>
  <button type="button" data-history-direction="1" disabled>
    <span>
      次のページ<span class="desktop-label">へ進む</span>
    </span>{' '}
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </button>
</nav>

<script>
  import { initializeHistoryNavigation } from '../lib/history-navigation';
  initializeHistoryNavigation();
</script>

<style>
  .history-navigation {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 8px max(20px, calc((100% - 1180px) / 2));
    color: var(--ink);
  }
  button {
    min-height: 44px;
    min-width: 112px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--beige);
    color: inherit;
    font: 14px/1.5 var(--sans);
    white-space: nowrap;
  }
  .arrow {
    font-size: 0.9em;
  }
  button:disabled {
    opacity: 1;
    color: var(--muted);
    border-style: dashed;
    cursor: default;
  }
  button:not(:disabled):hover {
    background: var(--paper);
  }
  @media (max-width: 767px) {
    .history-navigation {
      position: static;
      gap: 10px;
      margin-top: 24px;
      padding: 0 max(16px, env(safe-area-inset-right))
        calc(20px + env(safe-area-inset-bottom))
        max(16px, env(safe-area-inset-left));
    }
    button {
      flex: 0 0 auto;
      min-width: 0;
      min-height: 44px;
      padding: 0 13px;
      background: var(--beige);
      font-size: 12px;
    }
    .desktop-label {
      display: none;
    }
    :global(body[data-home='true']) .history-navigation {
      display: none;
    }
  }
</style>
