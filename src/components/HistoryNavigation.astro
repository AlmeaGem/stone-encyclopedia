---
import { pathTo } from '../lib/urls';
---

<nav
  class="history-navigation"
  aria-label="閲覧履歴の移動"
  data-history-base={pathTo()}
>
  <button type="button" data-history-direction="-1" disabled>
    ← 前のページへ戻る
  </button>
  <button type="button" data-history-direction="1" disabled>
    次のページへ進む →
  </button>
</nav>

<script>
  import { initializeHistoryNavigation } from '../lib/history-navigation';
  initializeHistoryNavigation();
</script>

<style>
  .history-navigation {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 8px max(20px, calc((100% - 1180px) / 2));
    color: var(--ink);
  }
  button {
    min-height: 44px;
    min-width: 112px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--beige);
    color: inherit;
    font: 14px/1.5 var(--sans);
  }
  button:disabled {
    opacity: 1;
    color: var(--muted);
    border-style: dashed;
    cursor: default;
  }
  button:not(:disabled):hover {
    background: var(--paper);
  }
  @media (max-width: 767px) {
    .history-navigation {
      position: fixed;
      inset: auto 0 0;
      z-index: 9;
      padding: 6px max(12px, env(safe-area-inset-right))
        calc(6px + env(safe-area-inset-bottom))
        max(12px, env(safe-area-inset-left));
      background: transparent;
      border-top: 0;
      box-shadow: none;
      pointer-events: none;
    }
    button {
      flex: 0 1 180px;
      min-width: 0;
      min-height: 44px;
      padding-inline: 5px;
      background: var(--beige);
      box-shadow: 0 2px 10px rgb(51 44 41 / 9%);
      pointer-events: auto;
      font-size: 12px;
    }
    :global(body[data-home='true']) .history-navigation {
      display: none;
    }
    :global(body[data-home='true']) {
      padding-bottom: env(safe-area-inset-bottom);
    }
    :global(body) {
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
    :global(html:has(body[data-home='true'])) {
      scroll-padding-bottom: env(safe-area-inset-bottom);
    }
    :global(html) {
      scroll-padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
  }
</style>
