---
import Visual from './Visual.astro';
import { stoneById } from '../lib/content';
import { pathTo } from '../lib/urls';
import type { z } from 'zod';
import type { archiveArticleSchema } from '../lib/archive-schema';

type Article = z.infer<typeof archiveArticleSchema>;
const { article } = Astro.props as { article: Article };
const motif =
  article.id === 'moonstone-moonlight'
    ? 'moon'
    : article.id === 'egyptian-amulets'
      ? 'lotus'
      : article.number === 3
        ? 'heart'
        : article.number === 4
          ? 'prism'
          : article.number === 5
            ? 'traveler'
            : undefined;
const escapedTitle = article.title.replace(
  /[&<>"']/g,
  (character) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[
      character
    ]!,
);
const titleHtml =
  motif === 'moon'
    ? escapedTitle.replace(
        '重ねられた',
        '<span class="archive-phrase">重ねられた</span>',
      )
    : escapedTitle;
const related = article.stoneIds.map((id) => {
  const stone = stoneById(id);
  if (!stone) throw new Error(`Unknown archive stone: ${id}`);
  return stone;
});
---

<article class:list={['archive-article', motif && `archive-${motif}`]}>
  <header class="page-intro archive-intro">
    {motif === 'moon' && (
      <svg
        class="archive-motif"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M40 10a22 22 0 1 0 13 35A20 20 0 0 1 40 10Z" />
        <path d="M49 12v9m-4.5-4.5h9M55 27v5m-2.5-2.5h5M15 13v5m-2.5-2.5h5" />
        <circle cx="13" cy="34" r=".9" fill="currentColor" stroke="none" />
      </svg>
    )}
    {motif === 'lotus' && (
      <svg
        class="archive-motif"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M32 48C19 44 13 34 13 23c8 2 14 7 19 15 5-8 11-13 19-15 0 11-6 21-19 25Z" />
        <path d="M32 38C26 29 26 20 32 12c6 8 6 17 0 26ZM20 45c-4 0-8-1-11-3m35 3c4 0 8-1 11-3M17 53h30M23 57h18" />
      </svg>
    )}
    {motif === 'heart' && (
      <svg
        class="archive-motif archive-heart-mark"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M32 51C27 47 12 37 12 26c0-10 12-14 20-5 8-9 20-5 20 5 0 11-15 21-20 25Z" />
        <path d="M51 9v8m-4-4h8M13 12v5m-2.5-2.5h5" />
        <circle cx="53" cy="34" r=".8" fill="currentColor" stroke="none" />
      </svg>
    )}
    {motif === 'prism' && (
      <svg
        class="archive-motif archive-prism-mark"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M13 25 21 14h22l8 11-19 27L13 25Z" />
        <path d="m13 25 19 3 19-3M21 14l11 14 11-14M32 28v24" />
        <path d="m22 34 13-13" stroke="#c6a4a6" />
        <path d="m26 38 13-13" stroke="#c3b89f" />
        <path d="m30 42 13-13" stroke="#aabeb9" />
      </svg>
    )}
    {motif === 'traveler' && (
      <svg
        class="archive-motif archive-traveler-mark"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="33" cy="17" r="4" />
        <path d="M32 22c-3 4-4 8-3 13l-5 12m6-12 7 11m-6-21 8 5m-9-5-6 8m15-3 6 18M17 52c8-5 17-4 30-8M10 54c12-2 24 0 44-2" />
        <path d="M26 25c-5-1-7 4-6 9l6 2" />
      </svg>
    )}
    <p class="eyebrow">ARCHIVE {String(article.number).padStart(2, '0')}</p>
    <h1 set:html={titleHtml} />
    <p>{article.introduction}</p>
  </header>
  <div class="archive-reading">
    {article.sections.map((section) => (
      <section class="archive-chapter">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="archive-citations">
          <span class="archive-citations-label">参考：</span>
          {section.sourceIds.map((id, index) => (
            <>
              <a href={`#archive-source-${id}`}>
                {article.sources.find((source) => source.id === id)?.title}
              </a>
              {index < section.sourceIds.length - 1 && '、'}
            </>
          ))}
        </p>
      </section>
    ))}
    <section class="archive-chapter" aria-labelledby="archive-stones">
      <h2 id="archive-stones">この物語に登場した石</h2>
      <div class="story-stone-grid">
        {related.map((stone) => (
          <article class="story-stone-card">
            <a href={pathTo(`stones/${stone.slug}/`)}>
              <Visual stone={stone} />
              <div class="story-stone-copy">
                <span class="eyebrow">{stone.id.toUpperCase()}</span>
                <h3>{stone.name}</h3>
                <span class="text-link">石の図鑑を見る ↗</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="archive-chapter" aria-labelledby="archive-references">
      <h2 id="archive-references">参考資料</h2>
      <ul>
        {article.sources.map((source) => (
          <li id={`archive-source-${source.id}`}>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              {source.title} ↗
            </a>{' '}
            — {source.institution}
          </li>
        ))}
      </ul>
    </section>
  </div>
</article>

<style>
  .archive-intro {
    position: relative;
  }
  .archive-intro .eyebrow {
    padding-right: 76px;
  }
  :global(.archive-phrase) {
    white-space: nowrap;
  }
  .archive-motif {
    position: absolute;
    right: 4px;
    top: 0;
    width: 58px;
    height: 58px;
    color: #b9a18b;
    opacity: 0.8;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .archive-heart .archive-intro h1,
  .archive-prism .archive-intro h1,
  .archive-traveler .archive-intro h1 {
    margin-top: 32px;
  }
  .archive-heart-mark {
    color: #b99394;
  }
  .archive-prism-mark {
    color: #b7a89c;
  }
  .archive-traveler-mark {
    color: #a58c76;
  }
  .archive-article h1 {
    max-width: 25ch;
    text-wrap: balance;
    overflow-wrap: break-word;
    word-break: normal;
    line-break: strict;
  }
  .archive-article h2,
  .archive-intro > p,
  .archive-chapter p,
  .archive-chapter li {
    word-break: normal;
    overflow-wrap: break-word;
    line-break: strict;
  }
  .archive-intro > p,
  .archive-chapter p:not(.archive-citations) {
    text-wrap: pretty;
  }
  .archive-article h2 {
    text-wrap: balance;
  }
  .archive-reading {
    max-width: 760px;
    margin-inline: auto;
  }
  .archive-chapter {
    padding-block: 2rem;
    border-top: 1px solid #e6dad1;
  }
  .archive-chapter h2 {
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    margin-bottom: 1.3rem;
  }
  .archive-chapter p,
  .archive-chapter li {
    line-height: 2.1;
  }
  .archive-chapter p + p {
    margin-top: 1em;
  }
  .archive-citations {
    font-size: 0.85em;
    color: #75655d;
  }
  .archive-citations-label {
    white-space: nowrap;
  }
  .archive-moon .archive-chapter,
  .archive-lotus .archive-chapter {
    position: relative;
  }
  .archive-moon .archive-chapter::before {
    content: '✧';
    position: absolute;
    top: -0.7em;
    right: 0;
    padding-left: 0.45em;
    background: #faf7f2;
    color: #b9a18b;
    font-size: 0.85rem;
  }
  .archive-lotus .archive-chapter::before {
    content: '';
    position: absolute;
    top: -2px;
    right: 0;
    width: 40px;
    border-top: 3px double #cbb6a3;
  }
  @media (max-width: 430px) {
    .archive-intro .eyebrow {
      padding-right: 50px;
    }
    .archive-intro h1 {
      margin-top: 12px;
    }
    .archive-motif {
      width: 40px;
      height: 40px;
      right: 0;
    }
    .archive-heart .archive-intro h1,
    .archive-prism .archive-intro h1,
    .archive-traveler .archive-intro h1 {
      margin-top: 32px;
    }
    .archive-heart-mark {
      color: #b99394;
    }
    .archive-prism-mark {
      color: #b7a89c;
    }
    .archive-traveler-mark {
      color: #a58c76;
    }
    .archive-article h1 {
      letter-spacing: 0.02em;
      line-height: 1.55;
    }
    .archive-chapter {
      padding-block: 1.75rem;
    }
    .archive-chapter h2 {
      line-height: 1.65;
      letter-spacing: 0.02em;
    }
  }
  .archive-chapter li + li {
    margin-top: 0.8rem;
  }
</style>
