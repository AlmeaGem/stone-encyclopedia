---
interface Props {
  title: string;
  level?: 'h1' | 'h2' | 'h3';
  protectWords?: boolean;
  sectionHeading?: boolean;
  mobileLines?: string[];
}
const {
  title,
  level = 'h3',
  protectWords = false,
  sectionHeading = false,
  mobileLines,
} = Astro.props;
const Tag = level;
const phrases = title.match(/[^。、！？]+[。、！？]?/gu) || [title];
const protectedPhrases = [
  'ものではありません',
  'ではありません',
  'ひとつの鉱物',
  '限りません',
  '身につける',
  '名前より先に',
  '完璧ではない',
  '傷めない',
  '鉱物名',
  '流通名',
  '形状名',
];
const protectedPattern = new RegExp(`(${protectedPhrases.join('|')})`, 'u');
---

<Tag class:list={['article-title', { 'section-title': sectionHeading }]}>
  {phrases.map((phrase) =>
    protectWords ? (
      <span class:list={[mobileLines && 'article-heading-standard']}>
        {phrase
          .split(protectedPattern)
          .map((part) =>
            protectedPhrases.includes(part) ? (
              <span class="title-run">{part}</span>
            ) : (
              part
            ),
          )}
      </span>
    ) : (
      phrase.split(/(?<=・)/u).map((part) => <span>{part}</span>)
    ),
  )}
  {mobileLines?.map((line) => <span class="article-heading-mobile-line">{line}</span>)}
</Tag>
