---
import { stones } from '../lib/content';
import { pathTo } from '../lib/urls';

interface Props {
  stoneId: string;
}
const ordered = [...stones].sort((a, b) =>
  a.id.localeCompare(b.id, 'en', { numeric: true }),
);
const index = ordered.findIndex((stone) => stone.id === Astro.props.stoneId);
const previous = index > 0 ? ordered[index - 1] : undefined;
const next = index >= 0 ? ordered[index + 1] : undefined;
---

<nav class="stone-navigation" aria-label="石のページ移動">
  {previous ? (
    <a
      href={pathTo(`stones/${previous.slug}/`)}
      rel="prev"
      aria-label={`前の石：${previous.name}`}
    >
      <span aria-hidden="true">←</span> 前の石
    </a>
  ) : (
    <span class="unavailable" aria-disabled="true">
      ← 前の石
    </span>
  )}
  <a href={pathTo('stones/')}>一覧</a>
  {next ? (
    <a
      href={pathTo(`stones/${next.slug}/`)}
      rel="next"
      aria-label={`次の石：${next.name}`}
    >
      次の石 <span aria-hidden="true">→</span>
    </a>
  ) : (
    <span class="unavailable" aria-disabled="true">
      次の石 →
    </span>
  )}
</nav>

<style>
  .stone-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    margin: 40px 0;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--beige);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.5;
  }
  .stone-navigation > * {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    min-height: 48px;
    border-radius: 6px;
  }
  .stone-navigation a:hover {
    background: var(--paper);
  }
  .unavailable {
    color: var(--muted);
  }
</style>
