---
import {
  inlineManuscript,
  manuscriptItems,
  manuscriptPairings,
  type ManuscriptSection,
} from '../lib/approved-manuscripts';
import { pathTo } from '../lib/urls';
import StoneNameText from './StoneNameText.astro';
import stones from '../content/stones.json';
import priorityCopy from '../content/editorial-priority-a.json';
import priorityB from '../content/editorial-priority-b.json';
interface Props {
  section: ManuscriptSection;
  protectStoneNames?: boolean;
  extendedStoneNames?: boolean;
  stoneId?: string;
}
const { section, protectStoneNames = false, extendedStoneNames = false, stoneId = '' } = Astro.props;
const items = manuscriptItems(section);
const pairings = manuscriptPairings(section);
const priority = priorityCopy[stoneId as keyof typeof priorityCopy] ?? priorityB[stoneId as keyof typeof priorityB];
const stoneById = new Map(stones.map((stone) => [stone.id, stone]));
---

{section.kind === 'wishes' ? (
  <ul class="manuscript-wishes">
    {items.map((text) => (
      <li>
        {inlineManuscript(text).map((part) =>
          part.strong ? <strong><StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} /></strong> : <StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} />,
        )}
      </li>
    ))}
  </ul>
) : section.kind === 'pairings' ? (
  <div class="manuscript-pairings">
    {pairings.map((pairing) => (
      <p class="manuscript-paragraph">
        <a
          class="text-link manuscript-pairing-name"
          href={pathTo(`stones/${stoneById.get(pairing.stoneId)!.slug}/`)}
        >
          <StoneNameText text={pairing.name} enabled={protectStoneNames} extended={extendedStoneNames} />
        </a>
        <span class="manuscript-pairing-separator">：</span>
        <span class="manuscript-pairing-description">
          {inlineManuscript(pairing.description).map((part) =>
            part.strong ? <strong><StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} /></strong> : <StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} />,
          )}{priority && priority.pairings[pairing.name as keyof typeof priority.pairings] && <span> <StoneNameText text={priority.pairings[pairing.name as keyof typeof priority.pairings]} enabled={true} extended={true} /></span>}
        </span>
      </p>
    ))}
  </div>
) : (
  items.map((text) => (
    <p class="prose-lines manuscript-paragraph">
      {inlineManuscript(text).map((part) =>
        part.strong ? <strong><StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} /></strong> : <StoneNameText text={part.text} enabled={protectStoneNames} extended={extendedStoneNames} />,
      )}
    </p>
  ))
)}
