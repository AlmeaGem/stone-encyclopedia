---
import SectionHeading from '../components/SectionHeading.astro';
import JournalCard from '../components/JournalCard.astro';
import '../journal.css';
import '../home-polish.css';
import Page from '../layouts/Page.astro';
import ReportOffer from '../components/ReportOffer.astro';
import ServiceComparison from '../components/ServiceComparison.astro';
import Card from '../components/Card.astro';
import DailyDiscovery from '../components/DailyDiscovery.astro';
import ArchiveShelf from '../components/ArchiveShelf.astro';
import { stones, categories, articles } from '../lib/content';
import { pathTo, canonical } from '../lib/urls';
const picks = ['s107', 's134', 's110', 's133', 's205', 's187'].map((id) =>
  stones.find((s) => s.id === id)!,
);
---

<Page
  home
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '天然石・パワーストーン大図鑑',
    url: canonical(),
    inLanguage: 'ja-JP',
    publisher: { '@type': 'Organization', name: 'ALMÉA GEM' },
  }}
>
  <section class="home-hero wrap typography-hero">
    <div class="hero-copy">
      <div
        class="mobile-hero-scene"
        style={`background-image: url("${pathTo('decorative/home-ivory-gems.webp')}")`}
        aria-hidden="true"
      ></div>
      <p class="eyebrow">POWER STONES · BY ALMÉA GEM</p>
      <h1>
        <span class="hero-line">
          本物の石は
          <br class="hero-mobile-break" />
          あなたのパワーになる。
        </span>
        <span class="hero-line">まだ知らない石の世界へ。</span>
      </h1>
      <p>
        パワーストーンアイテムを手がける
        <span style="white-space: nowrap">ALMÉA GEM</span>から。
        <br />
        <span class="hero-intro-line">
          石の個性と意味を知り、あなたの願いに寄り添う一粒を。
        </span>
      </p>
      <div class="hero-visual">
        <img
          src={pathTo('decorative/home-gem.webp')}
          alt=""
          width="750"
          height="1125"
        />
        <span class="hero-star-glow" aria-hidden="true"></span>
      </div>
      <div class="mobile-reference-art" aria-hidden="true">
        <img src={pathTo('decorative/star-rose-cutout.webp')} alt="" />
      </div>
      <nav class="mobile-luxury-menu" aria-label="サービスを探す">
        <a href={pathTo('stones/')}>
          <span class="luxury-icon" aria-hidden="true">
            ◇
          </span>
          <span>
            <strong>天然石図鑑</strong>
            <small>STONE ARCHIVE</small>
          </span>
        </a>
        <a href={pathTo('archives/')}>
          <span class="luxury-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path
                d="M16 8c-3-3-7-3-12-2v18c5-1 9-1 12 2m0-18c3-3 7-3 12-2v18c-5-1-9-1-12 2m0-18v18"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span>
            <strong>石の伝承図書館</strong>
            <small>STONE STORIES</small>
          </span>
        </a>
        <a href={pathTo('wishes/')}>
          <span class="luxury-icon" aria-hidden="true">
            ☾
          </span>
          <span>
            <strong>願いから探す</strong>
            <small>FIND BY INTENTION</small>
          </span>
        </a>
        <a href={pathTo('library/')}>
          <span class="luxury-icon" aria-hidden="true">
            ♡
          </span>
          <span>
            <strong>My書架</strong>
            <small>MY COLLECTION</small>
          </span>
        </a>
        <a class="luxury-designer" href={pathTo('bracelet-designer/')}>
          <span class="luxury-icon" aria-hidden="true">
            ◌
          </span>
          <span>
            <strong>デザインする</strong>
            <small>BRACELET DESIGNER</small>
          </span>
        </a>
        <a class="luxury-diagnosis" href={pathTo('diagnosis/')}>
          <span class="luxury-icon" aria-hidden="true">
            ✧
          </span>
          <span>
            <strong>パーソナル診断</strong>
            <small>COMING SOON</small>
          </span>
        </a>
      </nav>
      <nav class="mobile-primary-actions" aria-label="主なサービス">
        <a href={pathTo('stones/')}>
          <span aria-hidden="true">⌕</span> 石を探す
        </a>
        <a href={pathTo('bracelet-designer/')}>ブレスレットをデザインする</a>
      </nav>
      <nav class="entry-actions" aria-label="利用するサービスを選ぶ">
        <a href={pathTo('stones/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/opal-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong>天然石図鑑</strong>
            <span>210種類の石を詳しく見る ↗</span>
          </span>
        </a>
        <a href={pathTo('bracelet-designer/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/star-rose-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong style="white-space: nowrap">
              ブレスレットを
              <br />
              デザインする
            </strong>
            <span>210種類の石から自由にデザイン ↗</span>
          </span>
        </a>
        <a href={pathTo('diagnosis/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/ametrine-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong>パーソナル診断</strong>
            <span>質問無料・個別結果790円（準備中） ↗</span>
          </span>
        </a>
      </nav>
      <p class="home-search-shortcut">
        <a href="#home-search">このページで石を検索 ↓</a>
        <a href={pathTo('wishes/')}>願いから探す ↗</a>
      </p>
    </div>
  </section>
  <DailyDiscovery />
  <ArchiveShelf />
  <section
    id="home-search"
    class="home-search wrap"
    aria-labelledby="find-title"
  >
    <h2 id="find-title">今日、気になる石は？</h2>
    <p class="search-intro">石名・別名・願望・タグから探せます。</p>
    <form action={pathTo('stones/')} role="search">
      <label class="sr-only" for="home-q">
        石名・英語名・別名
      </label>
      <input id="home-q" name="q" type="search" placeholder="石名・願望など" />
      <button class="button" type="submit">
        検索 <span aria-hidden="true">→</span>
      </button>
    </form>
    <div class="search-suggestions">
      <span>たとえば</span>
      <a href={pathTo('stones/rose-quartz/')}>ローズクォーツ</a>
      <a href={pathTo('stones/amethyst/')}>アメジスト</a>
      <a href={pathTo('stones/labradorite/')}>ラブラドライト</a>
    </div>
    <details class="wish-search-shortcuts home-compact-links">
      <summary>願いのテーマから探す（12カテゴリー）</summary>
      <nav class="wish-search-links" aria-label="願望から石を探す">
        {categories.map((c) => (
          <a href={pathTo(`wishes/${c.id}/`)}>
            {c.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <p class="fine-print">
        石に伝えられる一般的な意味・象徴を探す無料検索です。個別選定結果とは異なります。
      </p>
    </details>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">STONE LIBRARY</p>
        <h2 class="library-title">
          <span>POWER STONE</span> <span>ENCYCLOPEDIA</span>
        </h2>
      </div>
      <a class="text-link" href={pathTo('stones/')}>
        すべての石を見る ↗
      </a>
    </div>
    <div class="stone-grid">
      {picks.map((stone) => (
        <Card stone={stone} />
      ))}
    </div>
    <p class="quiet-note">
      写真のない項目は、実物写真ではない抽象的な色のイメージで表示しています。
    </p>
  </section>
  <section
    class="journal-home wrap section"
    aria-labelledby="journal-home-title"
  >
    <div class="journal-home-heading">
      <div>
        <p class="journal-home-overline">THE GEMSTONE JOURNAL</p>
        <h2 id="journal-home-title">天然石の選び方・基礎知識</h2>
        <p>石を知るほど、選ぶ楽しさが深まる。</p>
      </div>
      <a class="journal-home-all" href={pathTo('articles/')}>
        すべての読みものを見る <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="journal-home-grid">
      {articles.map((article) => (
        <JournalCard article={article} />
      ))}
    </div>
  </section>
  <div class="wrap section">
    <ReportOffer />
    <details class="home-service-details">
      <summary>無料図鑑と790円レポートの違いを詳しく見る</summary>
      <ServiceComparison />
    </details>
  </div>
</Page>

<style>
  @media (max-width: 640px) {
    .hero-intro-line {
      text-shadow:
        0 1px 2px #211b17,
        0 0 5px #211b17;
    }
  }
  .home-search-shortcut {
    margin-top: 12px;
    font-size: 0.85rem;
  }
  .home-search-shortcut a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
