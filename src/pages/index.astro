---
import SectionHeading from '../components/SectionHeading.astro';
import JournalCard from '../components/JournalCard.astro';
import '../journal.css';
import '../home-polish.css';
import Page from '../layouts/Page.astro';
import ReportOffer from '../components/ReportOffer.astro';
import ServiceComparison from '../components/ServiceComparison.astro';
import Card from '../components/Card.astro';
import DailyDiscovery from '../components/DailyDiscovery.astro';
import ArchiveShelf from '../components/ArchiveShelf.astro';
import { stones, categories, articles } from '../lib/content';
import { pathTo, canonical } from '../lib/urls';
const picks = ['s107', 's134', 's110', 's133', 's205', 's187'].map((id) =>
  stones.find((s) => s.id === id)!,
);
---

<Page
  home
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '天然石・パワーストーン大図鑑',
    url: canonical(),
    inLanguage: 'ja-JP',
    publisher: { '@type': 'Organization', name: 'ALMÉA GEM' },
  }}
>
  <section class="home-hero wrap typography-hero">
    <div class="hero-copy">
      <div
        class="mobile-hero-scene"
        style={`background-image: url("${pathTo('decorative/home-ivory-gems.webp')}")`}
        aria-hidden="true"
      ></div>
      <p class="eyebrow">POWER STONES · BY ALMÉA GEM</p>
      <h1>
        <span class="hero-line">
          本物の石は
          <br class="hero-mobile-break" />
          あなたのパワーになる。
        </span>
        <span class="hero-line">まだ知らない石の世界へ。</span>
      </h1>
      <p>
        パワーストーンアイテムを手がける
        <span style="white-space: nowrap">ALMÉA GEM</span>から。
        <br />
        <span class="hero-intro-line">
          石の個性と意味を知り、あなたの願いに寄り添う一粒を。
        </span>
      </p>
      <div class="hero-visual">
        <img
          src={pathTo('decorative/home-gem.webp')}
          alt=""
          width="750"
          height="1125"
        />
        <span class="hero-star-glow" aria-hidden="true"></span>
      </div>
      <div class="mobile-reference-art" aria-hidden="true">
        <img src={pathTo('decorative/star-rose-cutout.webp')} alt="" />
      </div>
      <nav class="mobile-luxury-menu" aria-label="サービスを探す">
        <a href={pathTo('stones/')}>
          <span class="luxury-icon" aria-hidden="true">
            ◇
          </span>
          <span>
            <strong>天然石図鑑</strong>
            <small>STONE ARCHIVE</small>
          </span>
        </a>
        <a href={pathTo('archives/')}>
          <span class="luxury-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path
                d="M16 8c-3-3-7-3-12-2v18c5-1 9-1 12 2m0-18c3-3 7-3 12-2v18c-5-1-9-1-12 2m0-18v18"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span>
            <strong>石の伝承図書館</strong>
            <small>STONE STORIES</small>
          </span>
        </a>
        <a href={pathTo('wishes/')}>
          <span class="luxury-icon" aria-hidden="true">
            ☾
          </span>
          <span>
            <strong>願いから探す</strong>
            <small>FIND BY INTENTION</small>
          </span>
        </a>
        <a href={pathTo('library/')}>
          <span class="luxury-icon" aria-hidden="true">
            ♡
          </span>
          <span>
            <strong>My書架</strong>
            <small>MY COLLECTION</small>
          </span>
        </a>
        <a class="luxury-designer" href={pathTo('bracelet-designer/')}>
          <span class="luxury-icon" aria-hidden="true">
            ◌
          </span>
          <span>
            <strong>デザインする</strong>
            <small>BRACELET DESIGNER</small>
          </span>
        </a>
        <a class="luxury-diagnosis" href={pathTo('fortune/')}>
          <span class="luxury-icon" aria-hidden="true">
            ✧
          </span>
          <span>
            <strong>占い</strong>
            <small>FORTUNE &amp; GUIDANCE</small>
          </span>
        </a>
        <a class="mobile-guardian-entry" href={pathTo('find-your-stone/')}>
          <span class="luxury-icon" aria-hidden="true"><svg class="guardian-shield" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M20 4.5 31 8.7v8.2c0 8-4.8 13.7-11 17-6.2-3.3-11-9-11-17V8.7L20 4.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M20 12.5c.4 3.3 1.8 4.7 5.1 5.1-3.3.4-4.7 1.8-5.1 5.1-.4-3.3-1.8-4.7-5.1-5.1 3.3-.4 4.7-1.8 5.1-5.1ZM33 4.5v5M30.5 7h5M6 19v4M4 21h4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span>
          <span>
            <strong>守護石を調べる</strong>
            <small>GUARDIAN STONE</small>
            <span class="guardian-description">生年月日から、あなたの守護石を見つける</span>
          </span>
        </a>
      </nav>
      <nav class="mobile-primary-actions" aria-label="主なサービス">
        <a href={pathTo('stones/')}>
          <span aria-hidden="true">⌕</span> 石を探す
        </a>
        <a href={pathTo('bracelet-designer/')}>ブレスレットをデザインする</a>
      </nav>
      <nav class="entry-actions" aria-label="利用するサービスを選ぶ">
        <a href={pathTo('stones/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/opal-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong>天然石図鑑</strong>
            <span>212種類の石を詳しく見る ↗</span>
          </span>
        </a>
        <a href={pathTo('bracelet-designer/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/star-rose-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong style="white-space: nowrap">
              ブレスレットを
              <br />
              デザインする
            </strong>
            <span>212種類の石から自由にデザイン ↗</span>
          </span>
        </a>
        <a href={pathTo('fortune/')}>
          <img
            class="entry-art"
            src={pathTo('decorative/ametrine-cutout.webp')}
            alt=""
          />
          <span class="entry-copy">
            <strong>占い</strong>
            <span>占い・スピリチュアルコンテンツ ↗</span>
          </span>
        </a>
      </nav>
      <p class="home-search-shortcut">
        <a href="#home-search">このページで石を検索 ↓</a>
        <a href={pathTo('wishes/')}>願いから探す ↗</a>
      </p>
    </div>
  </section>
  <div class="wrap find-stone-entry">
    <a href={pathTo('find-your-stone/')}>
      <span class="guardian-entry-content">
        <span class="guardian-entry-icon" aria-hidden="true"><svg class="guardian-shield" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M20 4.5 31 8.7v8.2c0 8-4.8 13.7-11 17-6.2-3.3-11-9-11-17V8.7L20 4.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M20 12.5c.4 3.3 1.8 4.7 5.1 5.1-3.3.4-4.7 1.8-5.1 5.1-.4-3.3-1.8-4.7-5.1-5.1 3.3-.4 4.7-1.8 5.1-5.1ZM33 4.5v5M30.5 7h5M6 19v4M4 21h4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
            </svg></span>
        <span><small>GUARDIAN STONE</small><strong>守護石を調べる</strong><span class="guardian-description">生年月日から、あなたの守護石を見つける</span></span>
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <section class="wrap special-stones-home-entry" aria-labelledby="special-stones-home-title">
    <a href={pathTo('premium/')}>
      <svg class="premium-satin" viewBox="0 0 1100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="premium-rose-base" x1="0" y1="0" x2="1" y2="1">
            <stop stop-color="#e4baa6"/><stop offset=".28" stop-color="#f1d8c8"/><stop offset=".51" stop-color="#e6c2ae"/><stop offset=".76" stop-color="#f4dece"/><stop offset="1" stop-color="#d4a997"/>
          </linearGradient>
          <linearGradient id="premium-rose-fold" x1="0" y1="0" x2="0" y2="1">
            <stop stop-color="#fff7ed" stop-opacity=".12"/><stop offset=".44" stop-color="#fff9f0" stop-opacity=".95"/><stop offset=".62" stop-color="#e6bfaa" stop-opacity=".15"/><stop offset="1" stop-color="#9e6956" stop-opacity=".28"/>
          </linearGradient>
          <linearGradient id="premium-rose-sweep" x1="0" y1="0" x2="1" y2="0">
            <stop stop-color="#fff7ee" stop-opacity="0"/><stop offset=".4" stop-color="#fff7ee" stop-opacity=".18"/><stop offset=".75" stop-color="#fff9ef" stop-opacity=".85"/><stop offset="1" stop-color="#fff9ef" stop-opacity=".35"/>
          </linearGradient>
          <filter id="premium-rose-soft" x="-20%" y="-100%" width="140%" height="300%">
            <feGaussianBlur stdDeviation="5 3"/>
          </filter>
          <filter id="premium-rose-fine" x="-20%" y="-100%" width="140%" height="300%">
            <feGaussianBlur stdDeviation="2.5 1.6"/>
          </filter>
          <filter id="premium-rose-grain" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency=".43 .72" numOctaves="3" stitchTiles="stitch" seed="8"/>
            <feColorMatrix type="saturate" values="0"/>
          </filter>
        </defs>
        <rect width="1100" height="100" fill="url(#premium-rose-base)"/>
        <path d="M340 110 C520 92 578 64 714 60 S930 16 1080 -25 L1150 -5 C1010 49 896 79 730 84 S470 115 340 132Z" fill="url(#premium-rose-fold)" filter="url(#premium-rose-soft)"/>
        <path d="M305 109 C494 99 578 73 718 68 S921 37 1042 -11" fill="none" stroke="url(#premium-rose-sweep)" stroke-width="13" filter="url(#premium-rose-soft)"/>
        <path d="M405 105 C546 91 602 74 732 67 S931 33 1038 -10" fill="none" stroke="url(#premium-rose-sweep)" stroke-width="4.5" filter="url(#premium-rose-fine)"/>
        <path d="M665 118 C846 100 976 77 1106 34" fill="none" stroke="#b9826c" stroke-opacity=".13" stroke-width="22" filter="url(#premium-rose-soft)"/>
        <rect width="1100" height="100" filter="url(#premium-rose-grain)" opacity=".075" style="mix-blend-mode:soft-light"/>
      </svg>
      <span class="premium-entry-content">
        <span class="premium-entry-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="premium-gem-body" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#fffdf4"/><stop offset=".4" stop-color="#f7e5c8"/><stop offset=".68" stop-color="#eec1a2"/><stop offset="1" stop-color="#bf8d75"/>
              </linearGradient>
              <linearGradient id="premium-gem-opal" x1="0" y1="0" x2="1" y2="1">
                <stop stop-color="#fffdf8"/><stop offset=".5" stop-color="#d9e6e8"/><stop offset="1" stop-color="#e5b7a0"/>
              </linearGradient>
            </defs>
            <path d="M20 9 Q23 21 35 24 Q23 27 20 39 Q17 27 5 24 Q17 21 20 9Z" fill="url(#premium-gem-body)" stroke="#bd8d69" stroke-width=".65"/>
            <path d="M20 9 L20 24 5 24 Q17 21 20 9Z" fill="#fff9e9"/>
            <path d="M20 9 Q23 21 35 24 L20 24Z" fill="url(#premium-gem-opal)"/>
            <path d="M20 24 L35 24 Q23 27 20 39Z" fill="#d4a088"/>
            <path d="M20 24 L20 39 Q17 27 5 24Z" fill="url(#premium-gem-body)"/>
            <path d="M20 10 L20 38 M6 24 H34" stroke="#fff7e8" stroke-opacity=".8" stroke-width=".6"/>
            <path d="M36 2 Q38 10 46 12 Q38 14 36 22 Q34 14 26 12 Q34 10 36 2Z" fill="url(#premium-gem-body)" stroke="#c69673" stroke-width=".5"/>
            <path d="M36 2 L36 12 26 12 Q34 10 36 2Z" fill="#fffaf0"/>
            <path d="M36 12 L46 12 Q38 14 36 22Z" fill="url(#premium-gem-opal)"/>
            <path d="M8 33 Q9 38 14 39 Q9 40 8 45 Q7 40 2 39 Q7 38 8 33Z" fill="url(#premium-gem-body)" stroke="#c69673" stroke-width=".5"/>
          </svg>
        </span>
        <span class="premium-entry-copy"><small>ALMÉA GEM · PREMIUM</small><strong id="special-stones-home-title">体験型コンテンツはこちら</strong><span class="premium-description">限定記事・相性診断・占い</span></span>
      </span>
      <span aria-hidden="true">→</span>
    </a>
  </section>
  <DailyDiscovery />
  <ArchiveShelf />
  <section
    id="home-search"
    class="home-search wrap"
    aria-labelledby="find-title"
  >
    <h2 id="find-title">今日、気になる石は？</h2>
    <p class="search-intro">石名・別名・願望・タグから探せます。</p>
    <form action={pathTo('stones/')} role="search">
      <label class="sr-only" for="home-q">
        石名・英語名・別名
      </label>
      <input id="home-q" name="q" type="search" placeholder="石名・願望など" />
      <button class="button" type="submit">
        検索 <span aria-hidden="true">→</span>
      </button>
    </form>
    <div class="search-suggestions">
      <span>たとえば</span>
      <a href={pathTo('stones/rose-quartz/')}>ローズクォーツ</a>
      <a href={pathTo('stones/amethyst/')}>アメジスト</a>
      <a href={pathTo('stones/labradorite/')}>ラブラドライト</a>
    </div>
    <details class="wish-search-shortcuts home-compact-links">
      <summary>願いのテーマから探す（12カテゴリー）</summary>
      <nav class="wish-search-links" aria-label="願望から石を探す">
        {categories.map((c) => (
          <a href={pathTo(`wishes/${c.id}/`)}>
            {c.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <p class="fine-print">
        石に伝えられる一般的な意味・象徴を探す無料検索です。個別選定結果とは異なります。
      </p>
    </details>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">STONE LIBRARY</p>
        <h2 class="library-title">
          <span>POWER STONE</span> <span>ENCYCLOPEDIA</span>
        </h2>
      </div>
      <a class="text-link" href={pathTo('stones/')}>
        すべての石を見る ↗
      </a>
    </div>
    <div class="stone-grid">
      {picks.map((stone) => (
        <Card stone={stone} />
      ))}
    </div>
    <p class="quiet-note">
      写真のない項目は、実物写真ではない抽象的な色のイメージで表示しています。
    </p>
  </section>
  <section
    class="journal-home wrap section"
    aria-labelledby="journal-home-title"
  >
    <div class="journal-home-heading">
      <div>
        <p class="journal-home-overline">THE GEMSTONE JOURNAL</p>
        <h2 id="journal-home-title">天然石の選び方・基礎知識</h2>
        <p>石を知るほど、選ぶ楽しさが深まる。</p>
      </div>
      <a class="journal-home-all" href={pathTo('articles/')}>
        すべての読みものを見る <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="journal-home-grid">
      {articles.map((article) => (
        <JournalCard article={article} />
      ))}
    </div>
  </section>
  <div class="wrap section">
    <ReportOffer />
    <details class="home-service-details">
      <summary>無料図鑑と790円レポートの違いを詳しく見る</summary>
      <ServiceComparison />
    </details>
  </div>
</Page>

<style>
  @media (max-width: 640px) {
    .hero-intro-line {
      text-shadow:
        0 1px 2px #211b17,
        0 0 5px #211b17;
    }
  }
  .home-search-shortcut {
    margin-top: 12px;
    font-size: 0.85rem;
  }
  .home-search-shortcut a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
<style>
  .find-stone-entry { margin-block: 8px 20px; }
  .find-stone-entry a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 64px; padding: 12px 22px; border: 1px solid #e6dace; border-radius: 12px; background: #faf8f4; color: #514741; text-decoration: none; }
  .find-stone-entry small { display: block; color: #795a3b; font: 11px Georgia, serif; letter-spacing: .16em; }
  .find-stone-entry strong { display: block; margin-top: 5px; font-size: 16px; font-weight: 500; }
  .guardian-shield { display: block; width: 34px; height: 34px; color: #a58668; }
  .guardian-entry-content { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .guardian-entry-icon { flex: none; }
  .guardian-description { display: block; margin-top: 4px; color: #75665c; font-size: 12px; line-height: 1.5; }
  :global(body[data-home='true']) .mobile-luxury-menu .mobile-guardian-entry { display: none; }
  @media (max-width: 640px) {
    :global(body[data-home='true']) .mobile-luxury-menu .mobile-guardian-entry {
      display: flex;
      grid-column: 1 / -1;
    }
    .find-stone-entry { display: none; }
    :global(body[data-home='true'] .daily-discovery .daily-heading h2) { display: none; }
    :global(body[data-home='true']) .mobile-luxury-menu .mobile-guardian-entry .guardian-description {
      font-size: 11px;
      line-height: 1.5;
      margin-top: 1px;
    }
  }
</style>

<style>
  .special-stones-home-entry { margin-block: 8px 20px; }
  .special-stones-home-entry a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 12px 22px;
    border: 1px solid #c99e82;
    border-radius: 12px;
    background: #ecd0bf;
    color: #4b3027;
    text-decoration: none;
    box-shadow: 0 3px 9px #80523a24;
  }
  .special-stones-home-entry a::after {
    content: '';
    position: absolute;
    inset: 1px;
    border: 1px solid #fff8ec;
    border-radius: 10px;
    box-shadow: inset 0 0 5px #fff7e76b;
    pointer-events: none;
    z-index: 1;
  }
  .premium-satin {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 11px;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }
  .special-stones-home-entry small {
    display: block;
    color: #634332;
    font: 11px Georgia, serif;
    letter-spacing: .16em;
  }
  .special-stones-home-entry strong {
    display: block;
    margin-top: 3px;
    font-size: 19px;
    font-weight: 500;
    color: #4b3027;
    line-height: 1.5;
  }
  .premium-entry-content { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .premium-entry-icon { flex: none; }
  .premium-entry-icon svg {
    display: block;
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 1px 2px #925c3d36);
  }
  .premium-entry-copy { min-width: 0; }
  .premium-description { display: block; margin-top: 3px; color: #624333; font-size: 12px; line-height: 1.5; }
  .special-stones-home-entry a > span:last-child { flex: none; color: #634332; font-size: 19px; }
  .special-stones-home-entry a:hover { border-color: #b78365; box-shadow: 0 4px 12px #80523a30; }
  .special-stones-home-entry a:focus-visible { outline: 2px solid #91644e; outline-offset: 3px; }
  @media (max-width: 640px) {
    .special-stones-home-entry a { padding: 12px 14px; gap: 10px; }
    .premium-entry-content { gap: 10px; }
    .premium-entry-icon svg { width: 35px; height: 35px; }
    .special-stones-home-entry strong { font-size: 16px; }
    .premium-description { font-size: 11px; }
  }
</style>
