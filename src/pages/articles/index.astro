---
import Page from '../../layouts/Page.astro';
import JournalCard from '../../components/JournalCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articles } from '../../lib/content';
import '../../journal.css';
---

<Page title="天然石の選び方・品質・お手入れの読みもの" path="articles/">
  <div class="journal-page wrap">
    <Breadcrumbs items={[{ name: '読みもの' }]} />
    <header class="journal-intro">
      <p class="journal-english">THE GEMSTONE JOURNAL</p>
      <h1>天然石の選び方・基礎知識</h1>
      <p class="journal-subtitle">石を知るほど、選ぶ楽しさが深まる。</p>
    </header>
    <section class="journal-collection" aria-label="読みもの一覧">
      <div class="journal-grid">
        {articles.map((article) => (
          <JournalCard article={article} headingLevel="h2" />
        ))}
      </div>
    </section>
  </div>
</Page>
