---
import Prose from '../../components/Prose.astro';
import ReportNudge from '../../components/ReportNudge.astro';
import ArticleTitle from '../../components/ArticleTitle.astro';
import Page from '../../layouts/Page.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import { articles, stoneById, categories } from '../../lib/content';
import { canonical, pathTo } from '../../lib/urls';
export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}
const { article } = Astro.props;
const mobileHeadingLines: Record<string, string[]> = {
  '「好き」と「品質」は、違っていていい。': ['「好き」と「品質」は、', '違っていていい。'],
  '購入前に、表示を読む。': ['購入前に、表示を読む。'],
  '身につけるなら、扱いやすさも。': ['身につけるなら、', '扱いやすさも。'],
  '願いは、石に託す物語。': ['願いは、石に託す物語。'],
  'ひとつの名前が、ひとつの鉱物とは限りません。': ['ひとつの名前が、', 'ひとつの鉱物とは限りません。'],
  '「クラスター」は形を表す言葉。': ['「クラスター」は', '形を表す言葉。'],
  '似た色の石は、名前だけで決めない。': ['似た色の石は、', '名前だけで決めない。'],
  '石の中に見えるもの。': ['石の中に見えるもの。'],
  '見た目の個性と、傷のリスク。': ['見た目の個性と、', '傷のリスク。'],
  '伝承の強さを測るものではありません。': ['伝承の強さを', '測るものではありません。'],
  'まずは、何でできているか。': ['まずは、何でできているか。'],
  '日常の扱いは、控えめに。': ['日常の扱いは、控えめに。'],
  '浄化は伝承上の習慣。': ['浄化は伝承上の習慣。'],
  '不明なときは、販売者や専門家へ。': ['不明なときは、', '販売者や専門家へ。'],
  '同じピンクでも、見え方はさまざま。': ['同じピンクでも、', '見え方はさまざま。'],
  '流通名と鉱物名を行き来する。': ['流通名と鉱物名を', '行き来する。'],
  '恋愛への効果で順位を付けない。': ['恋愛への効果で', '順位を付けない。'],
  '三つの視点を分けます。': ['三つの視点を分けます。'],
  '石の性質を確かめる。': ['石の性質を確かめる。'],
  '写真と色の見方。': ['写真と色の見方。'],
  '図鑑と個別選定について。': ['図鑑と個別選定について。'],
};
const relatedWishIds = new Set(
  article.stoneIds.flatMap((id: string) => stoneById(id)?.wishes || []),
);
const relatedWishes = categories.filter((c) => relatedWishIds.has(c.id));
const otherArticles = articles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  dateModified: article.updatedAt,
  author: { '@type': 'Organization', name: 'ALMÉA GEM' },
  mainEntityOfPage: canonical(`articles/${article.slug}/`),
  inLanguage: 'ja-JP',
  isAccessibleForFree: true,
};
---

<Page
  title={article.title}
  description={article.description}
  path={`articles/${article.slug}/`}
  schema={schema}
>
  <div class="wrap">
    <Breadcrumbs
      items={[{ name: '読みもの', path: 'articles/' }, { name: article.title }]}
    />
    <article class="reading">
      <p class="eyebrow">{article.category} / FIELD NOTES</p>
      <ArticleTitle title={article.title} level="h1" />
      <p class="lead">{article.description}</p>
      <p class="updated">
        更新日 <time datetime={article.updatedAt}>{article.updatedAt}</time>
      </p>
      {article.sections.map((s) => (
        <section>
          <ArticleTitle
            title={s.heading}
            level="h2"
            protectWords
            sectionHeading
            mobileLines={mobileHeadingLines[s.heading]}
          />
          <Prose text={s.body} />
        </section>
      ))}
    </article>
    <section class="section">
      <h2>記事に関連する石</h2>
      <div class="stone-grid related-grid">
        {article.stoneIds
          .map(stoneById)
          .filter(Boolean)
          .map((s) => s && <Card stone={s} />)}
      </div>
    </section>
    <section class="section reading-next">
      <h2>関連する願望テーマ</h2>
      <nav class="related-links" aria-label="記事に関連する願望">
        {relatedWishes.map((c) => (
          <a class="text-link" href={pathTo(`wishes/${c.id}/`)}>
            {c.name} ↗
          </a>
        ))}
      </nav>
      <h2>別の記事を読む</h2>
      <nav class="related-links" aria-label="関連する記事">
        {otherArticles.map((a) => (
          <a class="sample-text-link" href={pathTo(`articles/${a.slug}/`)}>
            {a.title} ↗
          </a>
        ))}
      </nav>
    </section>
    <ReportNudge kind="article" />
  </div>
</Page>
