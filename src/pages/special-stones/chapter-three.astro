---
import Page from '../../layouts/Page.astro';
import { pathTo, launched, canonical } from '../../lib/urls';
import { chapterById } from '../../../services/special-stones/src/catalog.mjs';
import { stones } from '../../lib/content';
import Visual from '../../components/Visual.astro';
const chapter = chapterById('chapter-three')!;
const rutilePhotos: Record<string, string> = {
  'platinum-rutilated-quartz': 'special-stones/platinum-rutile.webp',
  'black-rutilated-quartz': 'special-stones/black-rutile.webp',
  'red-rutilated-quartz': 'special-stones/red-rutile.webp',
  'taichin-rutilated-quartz': 'special-stones/taichin-rutile.webp',
};
const gems = chapter.preview.map((g) => ({
  ...g,
  stone: stones.find((stone) => stone.slug === g.slug),
  photo: rutilePhotos[g.slug],
}));
const membersEnabled =
  launched &&
  (import.meta.env.PUBLIC_SPECIAL_STONES_MEMBERS_ENABLED === 'true' ||
    import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED === 'true') &&
  new URL(canonical()).origin === 'https://almeagem.com' &&
  import.meta.env.BASE_URL === '/';
const sales =
  membersEnabled &&
  chapter.sellable &&
  import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED === 'true';
const features = [
  ['01', '十種類の黄金ストーン', '好機・成功・繁栄を象徴する石の個性。'],
  ['02', '五つのルチルを比較', '金、銀、黒、赤、太い針の違いを知る。'],
  ['03', '黄金の三石チャート', '三つの石に重ねる願いを読み解く。'],
  ['04', '本物を選ぶために', '内包物・処理・品質とお手入れ。'],
  ['05', '願い別ブレスレットレシピ', '仕事・金運・転機・守護の組み合わせ。'],
  ['06', '選択式ミニ診断', '今の願いに寄り添う十種類の石から。'],
];
---

<Page
  title={chapter.title}
  description={chapter.description}
  path="special-stones/chapter-three/"
>
  <article class="golden wrap">
    <nav aria-label="現在地">
      <a href={pathTo()}>ホーム</a> /{' '}
      <a href={pathTo('premium/')}>プレミアム</a> /{' '}
      <a href={pathTo('special-stones/')}>スペシャルストーン</a> / 第三章
    </nav>
    <header class="golden-hero">
      <p class="overline">ALMÉA GEM · SPECIAL STONES · CHAPTER III</p>
      <img
        src={pathTo(chapter.cover)}
        width={chapter.width}
        height={chapter.height}
        alt={chapter.title + 'の表紙（三石のイメージ画像）'}
        fetchpriority="high"
      />
      <div>
        <p class="overline">THE ART OF PROSPERITY</p>
        <h1>
          黄金の石が秘める、
          <br />
          繁栄への鍵
        </h1>
        <p class="lead">
          好機をつかみ、豊かさを育てる。
          <br />
          黄金の輝きに、未来への願いを。
        </p>
        <p class="meta">無料紹介 · 本編150円（税込・買い切り）</p>
        <a class="hero-contents-link" href="#golden-contents">
          この章の内容を見る ↓
        </a>
      </div>
    </header>
    <div class="golden-copy">
      {chapter.intro.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <section class="golden-gems">
      <p class="overline">THE GOLDEN STONES</p>
      <h2>黄金の石、十の物語</h2>
      <p class="gallery-note">掲載画像は石の特徴を表現したイメージです。</p>
      <div class="gem-grid">
        {gems
          .filter((g) => g.stone)
          .map((g) => (
            <article>
              {g.stone && (
                <div class="gem-visual">
                  <Visual stone={g.stone} />
                </div>
              )}
              <div>
                <h3>{g.name}</h3>
                <p>{g.theme}</p>
                {g.slug === 'tiger-eye' && <p>タイガーアイの参考画像</p>}
              </div>
            </article>
          ))}
      </div>
      <div class="rutile-preview">
        <p class="overline">THE WORLD OF RUTILE</p>
        <h2>さらに、四つの針水晶へ</h2>
        <div class="rutile-grid">
          {gems
            .filter((g) => g.photo)
            .map((g) => (
              <article>
                <figure class="rutile-photo">
                  <img
                    src={pathTo(g.photo)}
                    alt={g.name + 'のイメージ画像'}
                    width="960"
                    height="960"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <h3>{g.name}</h3>
                <p>{g.theme}</p>
              </article>
            ))}
        </div>
      </div>
      <a class="gallery-more" href="#golden-contents">
        本編の内容を見る ↓
      </a>
    </section>
    <section class="golden-features" id="golden-contents">
      <p class="overline">INSIDE THE CHAPTER</p>
      <h2>豊かさへの鍵を、もっと深く。</h2>
      <div class="feature-grid">
        {features.map(([n, t, d]) => (
          <article>
            <span>{n}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="golden-offer">
      <p class="overline">CONTINUE THE STORY</p>
      <h2>物語の続きを開く</h2>
      <p>第三章の本編は購入者・対象月額会員限定です。</p>
      <div class="plans">
        <div>
          <strong>単品購入</strong>
          <b>150円</b>
          <small>税込・買い切り</small>
          {sales && (
            <a href={pathTo('members/?view=store&article=chapter-three')}>
              続きを読む →
            </a>
          )}
        </div>
        <div>
          <strong>月額会員</strong>
          <b>580円／月</b>
          <small>税込・対象記事読み放題・自動更新</small>
          {sales && (
            <a href={pathTo('members/?view=store&article=chapter-three')}>
              月額会員になる →
            </a>
          )}
        </div>
      </div>
      {!sales && <p>現在、販売準備中です。</p>}
      {membersEnabled && (
        <a class="member-link" href={pathTo('members/?view=account')}>
          会員登録・ログイン →
        </a>
      )}
    </section>
    <p class="fine">
      石の意味は伝承や象徴に基づくもので、将来や願いの実現を保証するものではありません。
    </p>
    <a class="back" href={pathTo('special-stones/')}>
      ← スペシャルストーン記事一覧へ戻る
    </a>
  </article>
</Page>
<style>
  .golden {
    max-width: 940px;
    padding-block: 24px 60px;
    color: #4b3931;
  }
  .golden nav {
    font-size: 12px;
    color: #806b60;
  }
  .golden nav a,
  .back {
    color: inherit;
  }
  .golden-hero {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: 26px;
    margin: 22px 0 26px;
    border: 1px solid #bda087;
    border-radius: 12px;
    background:
      radial-gradient(ellipse at 18% 10%, #fffaf5b3, transparent 45%),
      radial-gradient(ellipse at 88% 96%, #fffdf5b3, transparent 50%),
      linear-gradient(153deg, transparent 12%, #fffdf8d9 35%, transparent 64%),
      linear-gradient(115deg, #e4cdb7, #f8eee3 52%, #dfc3aa);
    box-shadow:
      inset 0 0 0 2px #fffaf5c0,
      0 5px 16px #74523c1a;
    color: #503b30;
  }
  .golden-hero > .overline {
    grid-column: 1/-1;
    text-align: center;
  }
  .overline {
    font:
      11px/1.7 Georgia,
      serif;
    letter-spacing: 0.15em;
    color: #5e4436;
    margin: 0;
  }
  .golden-hero img {
    width: 100%;
    height: auto;
    border-radius: 5px;
    box-shadow: 0 5px 12px #6a51402b;
  }
  .golden-hero h1 {
    font:
      500 clamp(25px, 4vw, 36px)/1.6 'Shippori Mincho',
      serif;
    color: #49362b;
    margin: 12px 0;
  }
  .lead {
    font-size: 15px;
    line-height: 1.9;
  }
  .meta {
    font-size: 12px;
  }
  .golden-copy {
    max-width: 660px;
    margin: 28px auto 40px;
    line-height: 2;
    font-size: 15px;
  }
  .golden-copy p {
    margin: 0 0 15px;
  }
  .golden-gems,
  .golden-features,
  .golden-offer {
    margin: 30px 0;
    text-align: center;
  }
  .golden h2 {
    font:
      500 clamp(20px, 3vw, 25px)/1.65 'Shippori Mincho',
      serif;
    margin: 8px 0 22px;
  }
  .gem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .gem-grid article,
  .feature-grid article {
    padding: 16px;
    border: 1px solid #ddc9b6;
    border-radius: 9px;
    background: #fffaf6;
    min-width: 0;
  }
  .gem-visual {
    max-width: 164px;
    margin: 0 auto 12px;
  }
  .gem-visual :global(.stone-figure) {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    max-width: none;
  }
  .gem-visual :global(.stone-image-frame) {
    margin: 0 !important;
    width: 100%;
    aspect-ratio: 1;
    min-height: 0;
  }
  .gem-visual :global(.stone-image-frame img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gem-grid h3,
  .feature-grid h3 {
    font:
      500 16px/1.6 'Shippori Mincho',
      serif;
    margin: 5px 0;
  }
  .gem-grid p,
  .feature-grid p {
    font-size: 13px;
    line-height: 1.8;
    margin: 0;
    color: #705e54;
  }
  .rutile-preview,
  .golden-features,
  .golden-offer {
    margin-top: 28px;
    padding: 25px 18px;
    border: 1px solid #d7c1ac;
    border-radius: 10px;
    background: linear-gradient(130deg, #f2e5d9, #fffbf7 65%, #ead8c8);
  }
  .rutile-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .rutile-grid article {
    min-width: 0;
    padding: 12px;
    border: 1px solid #ddc9b6;
    border-radius: 9px;
    background: #fffaf6;
  }
  .rutile-photo {
    margin: 0 auto 10px;
  }
  .rutile-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 5px;
  }
  .rutile-photo figcaption {
    margin: 5px 0 0;
    font-size: 11px;
    color: #705e54;
  }
  .rutile-grid h3 {
    font-size: 14px;
    line-height: 1.65;
    margin: 5px 0;
    overflow-wrap: anywhere;
  }
  .rutile-grid p {
    font-size: 13px;
    color: #705e54;
    margin: 0;
  }
  @media (max-width: 850px) {
    .rutile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .feature-grid,
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .feature-grid {
    text-align: left;
  }
  .feature-grid span {
    font:
      21px Georgia,
      serif;
    color: #886849;
  }
  .plans {
    max-width: 620px;
    margin: 20px auto;
  }
  .plans div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 16px;
    border: 1px solid #dfcbb7;
    border-radius: 7px;
    background: #fffdf9;
  }
  .plans b {
    font:
      500 24px 'Shippori Mincho',
      serif;
    color: #74543c;
  }
  .plans small,
  .fine,
  .back {
    font-size: 12px;
    line-height: 1.9;
  }
  .hero-contents-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 1px solid #bda087;
    border-radius: 7px;
    background: #fff9f1;
    color: #503b30;
    font-size: 13px;
    text-decoration: none;
    box-shadow: 0 2px 6px #74523c16;
  }
  .hero-contents-link:focus-visible {
    outline: 2px solid #765142;
    outline-offset: 3px;
  }
  .golden-features {
    scroll-margin-top: 20px;
  }
  .member-link,
  .plans a {
    display: block;
    max-width: 360px;
    margin: 12px auto;
    padding: 14px;
    border: 1px solid #b3967b;
    border-radius: 8px;
    background:
      linear-gradient(153deg, transparent 12%, #fffdf8d9 35%, transparent 64%),
      linear-gradient(115deg, #e4cdb7, #f8eee3 52%, #dfc3aa);
    box-shadow:
      0 3px 0 #a38a7245,
      inset 0 0 0 1px #fffaf4;
    color: #49362b;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .golden {
      padding-block: 16px 40px;
    }
    .golden-hero {
      grid-template-columns: 1fr;
      gap: 14px;
      text-align: center;
      padding: 18px 14px;
    }
    .golden-hero img {
      max-width: 145px;
      margin: auto;
    }
    .gem-grid {
      grid-template-columns: 1fr;
    }
    .gem-grid article {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr);
      align-items: center;
      text-align: left;
      gap: 14px;
    }
    .gem-visual {
      margin: 0;
    }
    .feature-grid article {
      padding: 10px;
    }
    .feature-grid h3 {
      font-size: 14px;
    }
    .plans {
      grid-template-columns: 1fr;
    }
  }
  /* Consistent compact gallery across the special-stone series. */
  .gem-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .gem-grid > article,
  .gem-grid > article:nth-child(-n + 3) {
    grid-column: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    gap: 0;
    min-width: 0;
    padding: 10px 8px;
    border: 1px solid #ddc9b6;
    border-radius: 9px;
  }
  .gem-grid .gem-visual {
    width: 100%;
    max-width: 116px;
    margin: 0 auto 6px;
  }
  .gem-grid .gem-visual > img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  .gem-grid h3 {
    font-size: 14px;
    line-height: 1.5;
    margin: 4px 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
    line-break: strict;
  }
  .gem-grid p {
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .gem-grid .gem-visual :global(.image-impression-label) {
    display: none;
  }
  @media (max-width: 850px) {
    .gem-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .gem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .gem-grid > article,
    .gem-grid > article:nth-child(-n + 3) {
      padding: 10px 6px;
    }
    .gem-grid .gem-visual {
      max-width: 92px;
      margin: 0 auto 5px;
    }
  }
  .gallery-note {
    font-size: 12px;
    color: #75675f;
    text-align: center;
    margin: 0 auto 14px;
  }
  .gallery-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 16px;
    padding: 8px 20px;
    border: 1px solid currentColor;
    border-radius: 7px;
    color: inherit;
    background: #fffaf580;
    font-size: 13px;
    text-decoration: none;
  }
  .gallery-more:hover {
    text-decoration: underline;
  }
  .gallery-more:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .rutile-grid article {
    padding: 10px 8px;
  }
  .rutile-photo {
    max-width: 116px;
    margin: 0 auto 6px;
  }
  .rutile-grid h3 {
    font-size: 14px;
    line-height: 1.5;
    text-wrap: balance;
  }
  .rutile-grid p {
    font-size: 12px;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .rutile-grid {
      gap: 8px;
    }
    .rutile-photo {
      max-width: 92px;
    }
  }
</style>
