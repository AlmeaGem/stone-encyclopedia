---
import Page from '../../layouts/Page.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { pathTo, launched, canonical } from '../../lib/urls';
import { chapterById } from '../../../services/special-stones/src/catalog.mjs';
import { stones } from '../../lib/content';
import Visual from '../../components/Visual.astro';
const chapter = chapterById('chapter-five')!;
const herkimerReady = existsSync(
  resolve('public/special-stones/herkimer-diamond.png'),
);
const gems = chapter.preview.map((g) => ({
  ...g,
  stone: stones.find((stone) => stone.slug === g.slug),
}));
const membersEnabled =
  launched &&
  (import.meta.env.PUBLIC_SPECIAL_STONES_MEMBERS_ENABLED === 'true' ||
    import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED === 'true') &&
  new URL(canonical()).origin === 'https://almeagem.com' &&
  import.meta.env.BASE_URL === '/';
const sales =
  membersEnabled &&
  chapter.sellable &&
  import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED === 'true';
const features = [
  ['01', '十四種類の強運・願望実現ストーン', '願い・好機・変容の象徴。'],
  ['02', '願いに向かう四つのステージ', '願い・転機・好機・現実化。'],
  ['03', '強運と願望実現は、同じなのか', '二つの願いを異なる視点から。'],
  ['04', '願い別・特別な組み合わせ', '強運と願望実現のブレスレットレシピ。'],
  ['05', '本物を選ぶための鉱物比較', '鉱物・品質・お手入れ。'],
  ['06', '世界三大ヒーリングストーン', '願いへ向かうための心の土台。'],
  ['07', 'カイヤナイト', '行き詰まった現状を切り開く。'],
  ['08', '今、あなたが望む奇跡は？', '選択式ミニ診断。'],
];
---

<Page
  title={chapter.title}
  description={chapter.description}
  path="special-stones/chapter-five/"
>
  <article class="rose wrap">
    <nav aria-label="現在地">
      <a href={pathTo()}>ホーム</a> /{' '}
      <a href={pathTo('premium/')}>プレミアム</a> /{' '}
      <a href={pathTo('special-stones/')}>スペシャルストーン</a> / 第五章
    </nav>
    <header class="rose-hero">
      <p class="overline">ALMÉA GEM · SPECIAL STONES · CHAPTER V</p>
      <img
        src={pathTo(chapter.cover)}
        width={chapter.width}
        height={chapter.height}
        alt={chapter.title + 'の表紙'}
        fetchpriority="high"
      />
      <div>
        <p class="overline">THE JEWELS OF MIRACLES & DESTINY</p>
        <h1>
          奇跡を呼び込む、
          <br />
          運命を変える石たち
        </h1>
        <p class="lead">
          <strong>まだ見ぬ未来に、幸運の扉を。</strong>
          <br />
          想像を超える好機。人生の転機。そして、心から望む願い。
        </p>
        <p class="hero-promise">
          十四種類の石から、未来の自分に重ねたい物語を見つける特集です。
        </p>
        <p class="meta">無料紹介 · 本編150円（税込・買い切り）</p>
        <a class="hero-contents-link" href="#rose-contents">
          無料で内容を見る ↓
        </a>
      </div>
    </header>
    <div class="rose-copy">
      {chapter.intro.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <section class="rose-gems">
      <p class="overline">THE JEWELS OF MIRACLES</p>
      <h2>十四の石、十四の未来への物語</h2>
      <p class="image-note">掲載画像は石の特徴を表現したイメージです。</p>
      <div class="gem-grid">
        {gems.map((g) => (
          <article>
            {(g.slug === 'herkimer-diamond' && herkimerReady) ||
            g.slug === 'libyan-glass' ? (
              <div class="gem-visual">
                <img
                  src={pathTo('special-stones/' + g.slug + '.png')}
                  alt={g.name + 'のイメージ画像'}
                  width="1024"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : g.stone ? (
              <div class="gem-visual">
                <Visual stone={g.stone} />
              </div>
            ) : (
              <div class="gem-visual rose-placeholder">
                <p>専用画像準備中</p>
              </div>
            )}
            <div>
              <h3>{g.name}</h3>
              <p>{g.theme}</p>
            </div>
          </article>
        ))}
      </div>
      <a class="gem-more" href="#rose-contents">
        本編の内容を見る ↓
      </a>
    </section>
    <aside class="love-editorial">
      <p class="overline">HEALING & RESET</p>
      <h2>願いを叶える前に、自分を整える石たち。</h2>
      <p>
        スギライト・ラリマー・チャロアイト。三つの癒しの石を、守る・ほどく・変化を受け入れるという異なるテーマで読み解きます。
      </p>
    </aside>
    <aside class="love-editorial breakthrough">
      <p class="overline">DIRECTION &amp; BREAKTHROUGH</p>
      <h2>行き詰まった現状を切り開く。</h2>
      <p>
        カイヤナイトを中心に、問題解決と現実化を象徴する石の組み合わせをご紹介します。
      </p>
    </aside>
    <section class="rose-features" id="rose-contents">
      <p class="overline">INSIDE THE CHAPTER</p>
      <h2>まだ知らない未来を、ひらく。</h2>
      <div class="feature-grid">
        {features.map(([n, t, d]) => (
          <article
            class:list={[
              { 'feature-spotlight': n === '06' || n === '07' || n === '08' },
            ]}
          >
            <span>{n}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="rose-offer">
      <p class="overline">CONTINUE THE STORY</p>
      <h2>物語の続きを開く</h2>
      <p>第五章の本編は購入者・対象月額会員限定です。</p>
      <div class="plans">
        <div>
          <strong>単品購入</strong>
          <b>150円</b>
          <small>税込・買い切り</small>
          {sales && (
            <a href={pathTo('members/?view=store&article=chapter-five')}>
              続きを読む →
            </a>
          )}
        </div>
        <div>
          <strong>月額会員</strong>
          <b>580円／月</b>
          <small>税込・対象記事読み放題・自動更新</small>
          {sales && (
            <a href={pathTo('members/?view=store&article=chapter-five')}>
              月額会員になる →
            </a>
          )}
        </div>
      </div>
      {!sales && (
        <p class="release-note">
          本編の販売開始に向けて準備を進めています。無料紹介をお楽しみください。
        </p>
      )}
      {membersEnabled && (
        <a class="member-link" href={pathTo('members/?view=account')}>
          会員登録・ログイン →
        </a>
      )}
    </section>
    <p class="fine">
      石の意味は伝承と編集上の象徴的解釈です。医療的な効果や願望成就を保証するものではありません。
    </p>
    <a class="back" href={pathTo('special-stones/')}>
      ← スペシャルストーン記事一覧へ戻る
    </a>
  </article>
</Page>
<style>
  .rose {
    max-width: 940px;
    padding-block: 24px 60px;
    color: #463950;
  }
  .rose nav {
    font-size: 12px;
    color: #75667c;
  }
  .rose nav a,
  .back {
    color: inherit;
  }
  .rose-hero {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: 26px;
    margin: 22px 0 26px;
    border: 1px solid #b7a1ca;
    border-radius: 12px;
    background:
      radial-gradient(ellipse at 18% 10%, #fffaf5b3, transparent 45%),
      radial-gradient(ellipse at 88% 96%, #fffdf5b3, transparent 50%),
      linear-gradient(153deg, transparent 12%, #fffdf8d9 35%, transparent 64%),
      linear-gradient(115deg, #d8c8e7, #fffcf7 52%, #d5c4e5);
    box-shadow:
      inset 0 0 0 2px #fffaf5c0,
      0 5px 16px #74523c1a;
    color: #574263;
  }
  .rose-hero > .overline {
    grid-column: 1/-1;
    text-align: center;
  }
  .overline {
    font:
      11px/1.7 Georgia,
      serif;
    letter-spacing: 0.15em;
    color: #685477;
    margin: 0;
  }
  .rose-hero img {
    width: 100%;
    height: auto;
    border-radius: 5px;
    box-shadow: 0 5px 12px #6a51402b;
  }
  .rose-hero h1 {
    font:
      500 clamp(25px, 4vw, 36px)/1.6 'Shippori Mincho',
      serif;
    color: #574263;
    margin: 12px 0;
  }
  .lead {
    font-size: 15px;
    line-height: 1.9;
  }
  .meta {
    font-size: 12px;
  }
  .rose-copy {
    max-width: 660px;
    margin: 28px auto 40px;
    line-height: 2;
    font-size: 15px;
  }
  .rose-copy p {
    margin: 0 0 15px;
  }
  .rose-gems,
  .rose-features,
  .rose-offer {
    margin: 30px 0;
    text-align: center;
  }
  .rose h2 {
    font:
      500 clamp(20px, 3vw, 25px)/1.65 'Shippori Mincho',
      serif;
    margin: 8px 0 22px;
  }
  .gem-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .gem-grid article,
  .feature-grid article {
    padding: 16px;
    border: 1px solid #dcd1e9;
    border-radius: 9px;
    background: #fdfaff;
    min-width: 0;
  }
  .gem-grid article {
    padding: 10px 8px;
  }
  .gem-visual {
    width: 100%;
    max-width: 116px;
    margin: 0 auto 6px;
  }
  .gem-visual :global(.stone-figure) {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    max-width: none;
  }
  .gem-visual :global(.stone-image-frame) {
    margin: 0 !important;
    width: 100%;
    aspect-ratio: 1;
    min-height: 0;
  }
  .gem-visual :global(.stone-image-frame img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gem-grid h3,
  .feature-grid h3 {
    font:
      500 16px/1.6 'Shippori Mincho',
      serif;
    margin: 5px 0;
  }
  .gem-grid p,
  .feature-grid p {
    font-size: 13px;
    line-height: 1.8;
    margin: 0;
    color: #65566f;
  }
  .gem-grid h3 {
    font-size: 14px;
    line-height: 1.5;
    margin: 4px 0;
    overflow-wrap: anywhere;
  }
  .gem-grid p {
    font-size: 12px;
    line-height: 1.5;
  }
  .rose-features,
  .rose-offer {
    margin-top: 28px;
    padding: 25px 18px;
    border: 1px solid #cbb9de;
    border-radius: 10px;
    background: linear-gradient(130deg, #e8dff3, #fffbf8 65%, #dfd2ee);
  }
  .rose-placeholder {
    display: grid;
    place-items: center;
    min-height: 0;
    aspect-ratio: 1;
    border: 1px solid #d6c8e5;
    border-radius: 6px;
    background: #f4eef9;
  }
  .feature-grid,
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .feature-grid {
    text-align: left;
  }
  .feature-grid span {
    font:
      21px Georgia,
      serif;
    color: #886849;
  }
  .plans {
    max-width: 620px;
    margin: 20px auto;
  }
  .plans div {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 16px;
    border: 1px solid #dbd0e7;
    border-radius: 7px;
    background: #fffdf9;
  }
  .plans b {
    font:
      500 24px 'Shippori Mincho',
      serif;
    color: #624c73;
  }
  .plans small,
  .fine,
  .back {
    font-size: 12px;
    line-height: 1.9;
  }
  .hero-contents-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 1px solid #b7a1ca;
    border-radius: 7px;
    background: #fff9f1;
    color: #574263;
    font-size: 13px;
    text-decoration: none;
    box-shadow: 0 2px 6px #74523c16;
  }
  .hero-contents-link:focus-visible {
    outline: 2px solid #765142;
    outline-offset: 3px;
  }
  .rose-features {
    scroll-margin-top: 20px;
  }
  .member-link,
  .plans a {
    display: block;
    max-width: 360px;
    margin: 12px auto;
    padding: 14px;
    border: 1px solid #b6a0c9;
    border-radius: 8px;
    background:
      linear-gradient(153deg, transparent 12%, #fffdf8d9 35%, transparent 64%),
      linear-gradient(115deg, #e4cdb7, #f8eee3 52%, #dfc3aa);
    box-shadow:
      0 3px 0 #a38a7245,
      inset 0 0 0 1px #fffaf4;
    color: #574263;
    font-weight: 600;
    text-decoration: none;
  }
  .rose-hero {
    grid-template-columns: 210px minmax(0, 1fr);
    background:
      radial-gradient(ellipse at 16% 75%, #fffaf6c9, transparent 60%),
      linear-gradient(
        145deg,
        transparent 19%,
        #fffaf6b3 38%,
        transparent 48%,
        #fff9f473 60%,
        transparent 74%
      ),
      linear-gradient(115deg, #d6c5e7, #fffbf6 50%, #d3c2e5);
  }
  .lead strong {
    font-size: 19px;
    color: #594174;
    font-weight: 600;
  }
  .hero-promise {
    font-size: 14px;
    line-height: 1.9;
    max-width: 35em;
  }
  .hero-contents-link {
    background: linear-gradient(125deg, #c7b0de, #f2eaf9 48%, #d3bee8);
    color: #4b315e;
    font-weight: 600;
    min-height: 48px;
    box-shadow:
      0 3px 0 #a78abf60,
      inset 0 0 0 1px #fffaf6;
  }
  .gem-visual :global(.image-impression-label) {
    display: none;
  }
  .gem-visual > img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 5px;
  }
  .image-note {
    color: #71617d;
    font-size: 12px;
    margin: -12px 0 18px;
  }
  .gem-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 16px;
    padding: 8px 20px;
    border: 1px solid #b6a0c9;
    border-radius: 7px;
    background: #f2eaf9;
    color: #574263;
    font-size: 13px;
    text-decoration: none;
  }
  .gem-more:hover {
    text-decoration: underline;
  }
  .gem-more:focus-visible {
    outline: 2px solid #694d82;
    outline-offset: 3px;
  }
  .love-editorial {
    padding: 30px 24px;
    text-align: center;
    background: linear-gradient(125deg, #e9dff4, #fffbf7 54%, #ded0ec);
    border: 1px solid #bda8d0;
    border-radius: 10px;
    color: #574263;
  }
  .love-editorial p:last-child {
    max-width: 40em;
    margin: auto;
    line-height: 1.9;
  }
  .breakthrough {
    margin-top: 18px;
    background: linear-gradient(125deg, #e3e7f6, #fffcf7 60%, #e6ddf3);
  }
  .feature-spotlight {
    border-color: #b49acb !important;
    background: #f2eaf9 !important;
  }
  .release-note {
    color: #624c73;
    font-size: 14px;
    line-height: 1.8;
  }
  @media (max-width: 850px) {
    .gem-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .rose {
      padding-block: 16px 40px;
    }
    .rose-hero {
      grid-template-columns: 1fr;
      gap: 14px;
      text-align: center;
      padding: 18px 14px;
    }
    .rose-hero img {
      max-width: 145px;
      margin: auto;
    }
    .gem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .gem-grid article {
      padding: 10px 6px;
    }
    .gem-visual {
      max-width: 92px;
      margin: 0 auto 5px;
    }
    .feature-grid article {
      padding: 10px;
    }
    .feature-grid h3 {
      font-size: 14px;
    }
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
