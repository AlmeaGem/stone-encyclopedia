---
import Page from '../../layouts/Page.astro';
import { pathTo, launched, canonical } from '../../lib/urls';
import { chapterById } from '../../../services/special-stones/src/catalog.mjs';
import { stones } from '../../lib/content';
import Visual from '../../components/Visual.astro';
const chapter = chapterById('chapter-two')!;
const gems = chapter.preview.map(g=>({...g,stone:stones.find(s=>s.slug===g.slug||s.name===g.name)}));
const membersEnabled = launched && (import.meta.env.PUBLIC_SPECIAL_STONES_MEMBERS_ENABLED==='true'||import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED==='true') && new URL(canonical()).origin==='https://almeagem.com' && import.meta.env.BASE_URL==='/';
const sales = membersEnabled && chapter.sellable && import.meta.env.PUBLIC_SPECIAL_STONES_SALES_ENABLED==='true';
const features=[['01','七つの宇宙ストーン','隕石と天然ガラスの誕生、特徴、伝承を知る。'],['02','特別な組み合わせ','人生の転機や願いに合わせた石選び。'],['03','宇宙の三石チャート','三つの石の象徴を視覚的に読み解く。'],['04','本物を選ぶために','来歴・鑑別・お手入れのチェックポイント。'],['05','七石の比較早見表','どの石が気になるか、違いをひと目で。'],['06','選択式ミニ診断','今、大切にしたい願いに寄り添う一粒を。']];
---
<Page title={chapter.title} description={chapter.description} path="special-stones/chapter-two/">
<article class="cosmic wrap">
 <nav aria-label="現在地"><a href={pathTo()}>ホーム</a> / <a href={pathTo('premium/')}>プレミアム</a> / <a href={pathTo('special-stones/')}>スペシャルストーン</a> / 第二章</nav>
 <header class="cosmic-hero">
  <p class="overline">ALMÉA GEM · SPECIAL STONES · CHAPTER II</p>
  <img src={pathTo(chapter.cover)} width={chapter.width} height={chapter.height} alt={chapter.title+'の表紙（抽象的なイラスト）'} fetchpriority="high"/>
  <div><p class="overline">THE MEMORY OF THE UNIVERSE</p><h1>宇宙から届いた、<br/>運命を拓く石</h1><p class="lead">幾億年もの時を超えて。<br/>宇宙と地球の出会いを、一粒に。</p><p class="meta">無料紹介 · 本編150円（税込・買い切り）</p></div>
 </header>
 <div class="cosmic-copy">{chapter.intro.map(p=><p>{p}</p>)}</div>
 <section class="cosmic-gems">
  <p class="overline">THE COSMIC STONES</p><h2>七つの石、七つの誕生の物語</h2>
  <div class="gem-grid">{gems.map((g,i)=><article>{g.stone ? <div class="gem-visual"><Visual stone={g.stone}/></div> : <div class="gem-symbol" aria-hidden="true">✧</div>}<div><span class="gem-no">0{i+1}</span><h3>{g.name}</h3><p>{g.theme}</p></div></article>)}</div>
 </section>
 <section class="cosmic-features"><p class="overline">INSIDE THE CHAPTER</p><h2>宇宙の石の秘密を、もっと深く。</h2><div class="feature-grid">{features.map(([n,t,d])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></section>
 <section class="cosmic-offer"><p class="overline">CONTINUE THE STORY</p><h2>物語の続きを開く</h2><p>第二章の本編は購入者・対象月額会員限定です。</p><div class="plans"><div><strong>単品購入</strong><b>150円</b><small>税込・買い切り</small>{sales&&<a href={pathTo('members/?view=store&article=chapter-two')}>続きを読む →</a>}</div><div><strong>月額会員</strong><b>580円／月</b><small>税込・対象記事読み放題・自動更新</small>{sales&&<a href={pathTo('members/?view=store&article=chapter-two')}>月額会員になる →</a>}</div></div>{!sales&&<p>現在、販売準備中です。</p>}{membersEnabled&&<a class="member-link" href={pathTo('members/?view=account')}>会員登録・ログイン →</a>}</section>
 <p class="fine">石の意味は伝承や象徴に基づくもので、将来や願いの実現を保証するものではありません。</p>
 <a class="back" href={pathTo('special-stones/')}>← スペシャルストーン記事一覧へ戻る</a>
</article>
</Page>
<style>
.cosmic{max-width:940px;padding-block:24px 60px;color:#4b3931}
.cosmic nav{font-size:12px;color:#806b60}.cosmic nav a{color:inherit}
.cosmic-hero{display:grid;grid-template-columns:160px minmax(0,1fr);align-items:center;gap:24px;padding:25px;margin:22px 0 26px;border:1px solid #ae9376;border-radius:12px;background:linear-gradient(132deg,transparent 22%,#e9d8bd16 45%,transparent 65%),linear-gradient(120deg,#182338,#30394e 52%,#141b2d);color:#f8eee3;box-shadow:inset 0 0 0 1px #e2c3a85c,0 4px 12px #25243118}
.cosmic-hero>.overline{grid-column:1/-1;text-align:center;margin:0}.overline{font:11px/1.7 Georgia,serif;letter-spacing:.15em;color:#896d58}.cosmic-hero .overline{color:#dcc2a3}
.cosmic-hero img{width:100%;height:auto;border-radius:4px;box-shadow:0 4px 14px #0005}
.cosmic-hero h1{font:500 clamp(25px,4vw,36px)/1.6 'Shippori Mincho',serif;color:#fff5e9;margin:12px 0}
.cosmic-hero .lead{font:400 15px/1.9 'Noto Serif JP',serif;color:#e6d8ca}.meta{font-size:12px;color:#d7c2ad}
.cosmic-copy{max-width:660px;margin:25px auto 40px;font:400 15px/2 'Noto Serif JP',serif}.cosmic-copy p{margin:0 0 15px}
.cosmic-gems,.cosmic-features,.cosmic-offer{margin:30px 0;text-align:center}
.cosmic h2{font:500 clamp(20px,3vw,25px)/1.65 'Shippori Mincho',serif;margin:8px 0 22px}
.gem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.gem-grid article{padding:14px;border:1px solid #d9c8b8;border-radius:8px;background:#fffaf5;min-width:0}
.gem-visual,.gem-symbol{width:100%;max-width:150px;aspect-ratio:1;margin:0 auto 10px;overflow:hidden;border-radius:5px}
.gem-visual :global(.stone-figure){margin:0!important;padding:0!important;width:100%;max-width:none}
.gem-visual :global(.stone-image-frame){margin:0!important;width:100%;aspect-ratio:1;min-height:0}
.gem-visual :global(.stone-image-frame img){width:100%;height:100%;object-fit:contain}
.gem-symbol{display:grid;place-items:center;color:#d6b996;background:#253047;font-size:40px}.gem-no{font:11px Georgia,serif;color:#a08368}
.gem-grid h3,.feature-grid h3{font:500 16px/1.6 'Shippori Mincho',serif;margin:5px 0}.gem-grid p,.feature-grid p{font-size:12px;line-height:1.8;color:#705e54;margin:0}
.cosmic-features{padding:24px 18px;background:#f7eee5;border:1px solid #dfcbbb;border-radius:9px}
.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;text-align:left}.feature-grid article{background:#fffcf8;padding:15px;border:1px solid #e1cdb9;border-radius:6px}.feature-grid span{font:20px Georgia,serif;color:#9c7859}
.cosmic-offer{padding:22px 16px;border:1px solid #c7a98a;border-radius:10px;background:linear-gradient(120deg,#f4e5d9,#fffcf6 55%,#efdbcb)}.cosmic-offer p{font-size:13px}
.plans{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px auto;max-width:620px}.plans div{display:flex;flex-direction:column;gap:6px;background:#fffaf6;padding:15px;border:1px solid #e2cebb;border-radius:6px}.plans strong{font-size:14px}.plans b{font:500 23px 'Shippori Mincho',serif;color:#654639}.plans small{font-size:12px}.member-link,.plans a{display:block;max-width:320px;margin:10px auto;background:#263247;color:#fff5e8;border:1px solid #b99a78;border-radius:6px;padding:11px;text-decoration:none;font-size:14px}
.fine,.back{font-size:12px;line-height:1.9;color:#79655f}.back{display:inline-block;margin-top:12px}
@media(max-width:640px){.cosmic{padding-block:16px 40px}.cosmic-hero{grid-template-columns:1fr;gap:14px;text-align:center;padding:18px 14px}.cosmic-hero img{max-width:145px;margin:auto}.cosmic-hero h1{font-size:25px}.gem-grid{grid-template-columns:1fr;gap:8px}.gem-grid article{display:grid;grid-template-columns:84px minmax(0,1fr);align-items:center;text-align:left;gap:12px;padding:10px}.gem-visual,.gem-symbol{margin:0}.feature-grid article{padding:10px}.feature-grid h3{font-size:14px}.plans{grid-template-columns:1fr}}

/* Starlight editorial finish */
.cosmic-hero{background:radial-gradient(circle at 12% 12%,#fff7e8 1.5px,transparent 3px),radial-gradient(circle at 49% 35%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 86% 58%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 26% 81%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 63% 15%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 3% 38%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 40% 61%,#fff7e8 1.5px,transparent 3px),radial-gradient(circle at 77% 84%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 17% 18%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 54% 41%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 91% 64%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 31% 87%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 68% 21%,#fff7e8 1.5px,transparent 3px),radial-gradient(circle at 8% 44%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 45% 67%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 82% 90%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 22% 24%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 59% 47%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 96% 70%,#fff7e8 1.5px,transparent 3px),radial-gradient(circle at 36% 93%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 73% 27%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 13% 50%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 50% 73%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(circle at 87% 7%,#fff7e8 0.7px,transparent 1.6px),radial-gradient(ellipse at 92% 20%,#b9a1c36b,transparent 48%),radial-gradient(ellipse at 64% 92%,#d2afaa43,transparent 48%),linear-gradient(120deg,#34384c,#565068 58%,#2c354b);border-color:#c9b29a;grid-template-columns:180px minmax(0,1fr)}
.cosmic-hero h1{color:#fff9f0;text-shadow:0 1px 3px #242138}
.cosmic-hero .lead,.cosmic-hero .meta,.cosmic-hero .overline{color:#fff1df}
.cosmic-copy{line-height:2.05}
.cosmic-gems h2,.cosmic-features h2{color:#51465c}
.gem-grid article{background:#fffcf9;border-color:#ded2dc}
.gem-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.cosmic-features{background:linear-gradient(130deg,#f2edf5,#faf5ed 65%);border-color:#d7c8d9}
@media(max-width:800px){.gem-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.cosmic-hero{grid-template-columns:1fr}.cosmic-copy{font-size:15px;line-height:1.9}.gem-grid{grid-template-columns:1fr}}
</style>