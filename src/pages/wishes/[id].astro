---
import Page from '../../layouts/Page.astro';
import ReportNudge from '../../components/ReportNudge.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import Visual from '../../components/Visual.astro';
import { guidesForCategory } from '../../lib/wish-guide';
import { categories, stones } from '../../lib/content';
import { pathTo } from '../../lib/urls';
import { availableWishTags } from '../../lib/wish-filter';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { id: category.id },
    props: { category },
  }));
}
const { category } = Astro.props;
const selected = stones.filter((s) => s.wishes.includes(category.id));
const tags = availableWishTags(selected);
const guides = guidesForCategory(category.id);
---

<Page
  title={`${category.name}の伝承・テーマを持つ石`}
  path={`wishes/${category.id}/`}
>
  <div class="wrap">
    <Breadcrumbs
      items={[
        { name: '願いから探す', path: 'wishes/' },
        { name: category.name },
      ]}
    />
    <div class="page-intro">
      <p class="eyebrow">STORIES & SYMBOLS</p>
      <h1>{category.name}</h1>
      <p>{category.description}</p>
    </div>
    {category.id === 'wellbeing' && (
      <p class="health-note">
        健康・美容にまつわる伝承を紹介します。医療や治療の代わりになるものではありません。
      </p>
    )}
    {guides.length > 0 && (
      <section class="wish-guide" aria-labelledby="wish-guide-title">
        <h2 id="wish-guide-title">目的から石を選ぶ</h2>
        <p>石の意味は伝承や象徴として紹介しています。</p>
        {guides.map((guide) => (
          <details class="wish-guide-topic">
            <summary>{guide.title}</summary>
            <p>{guide.introduction}</p>
            {['妊娠・出産', '健康運', 'ヒーリング', 'トラウマの解消'].includes(guide.title) && (
              <p class="wish-guide-note">石の意味はお守りとしての象徴です。医療・治療や専門的な支援の代わりにはなりません。</p>
            )}
            <div class="wish-guide-grid">
              {guide.stones.map((item) => {
                const stone = item.id ? stones.find((entry) => entry.id === item.id) : undefined;
                return <article class="wish-guide-stone">
                  {stone && <a href={pathTo(`stones/${stone.slug}/`)} aria-label={`${item.name}の詳細を見る`}><Visual stone={stone} /></a>}
                  <div><h3>{item.name}</h3><p>{item.meaning}</p>
                  {stone ? <a class="text-link" href={pathTo(`stones/${stone.slug}/`)}>石の詳細を見る ↗</a> : <p class="wish-guide-note">図鑑への掲載準備中</p>}</div>
                </article>;
              })}
            </div>
          </details>
        ))}
      </section>
    )}
    <section class="wish-filter" aria-labelledby="wish-filter-title" hidden>
      <h2 id="wish-filter-title">願いのテーマで絞り込む</h2>
      <p class="wish-filter-help">
        複数選ぶと、すべてのテーマを持つ石を表示します。
      </p>
      <div class="wish-filter-buttons" role="group" aria-label="願いのテーマ">
        <button type="button" data-clear-wishes aria-pressed="true">
          すべて表示
        </button>
        {tags.map((tag) => (
          <button type="button" data-wish-tag={tag} aria-pressed="false">
            <span class="wish-check" aria-hidden="true">
              ✓
            </span>
            <span class="wish-label">{tag}</span>
          </button>
        ))}
      </div>
    </section>
    <div class="list-status">
      <p id="wish-result-count" role="status" aria-live="polite">
        {selected.length}種類の天然石
      </p>
    </div>
    <p id="wish-empty" class="empty" hidden>
      選択したテーマすべてに当てはまる石は見つかりませんでした。
      <br />
      テーマを減らすか「すべて表示」をお試しください。
    </p>
    {selected.length ? (
      <div class="stone-grid">
        {selected.map((stone) => (
          <Card stone={stone} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <h2>このテーマの石はまだ掲載されていません。</h2>
        <p>ほかのテーマや石名からも探してみてください。</p>
        <a href={pathTo('stones/')}>すべての石を探す →</a>
      </div>
    )}
    <ReportNudge kind="category" />
  </div>
</Page>

<style>
  .wish-guide { margin: 0 0 30px; }
  .wish-guide > h2 { font-family: var(--heading-font); font-size: 22px; font-weight: 500; margin-bottom: 8px; }
  .wish-guide > p, .wish-guide-topic > p { font-size: 14px; line-height: 1.8; }
  .wish-guide-topic { margin-top: 12px; padding: 0 18px; border: 1px solid #dfd3c9; border-radius: 12px; background: #faf7f2; }
  .wish-guide-topic summary { padding: 15px 0; cursor: pointer; font-family: var(--heading-font); font-size: 18px; }
  .wish-guide-topic[open] { padding-bottom: 18px; }
  .wish-guide-note { color: #756b64; font-size: 12px !important; margin-top: 8px; }
  .wish-guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
  .wish-guide-stone { min-width: 0; padding: 14px; background: #fffdfa; border: 1px solid #eee5dc; border-radius: 10px; }
  .wish-guide-stone :global(.stone-figure) { margin: 0; }
  .wish-guide-stone h3 { font-size: 16px; margin: 10px 0 6px; font-weight: 500; }
  .wish-guide-stone p { font-size: 13px; line-height: 1.75; }
  .wish-guide-stone .text-link { display: inline-flex; align-items: center; width: max-content; min-width: 0; min-height: 32px; height: 32px; padding: 0 7px; margin-top: 8px; font-size: 12px; line-height: 1; white-space: nowrap; }
  @media (max-width: 640px) { .wish-guide-grid { grid-template-columns: 1fr; } .wish-guide-stone { display: grid; grid-template-columns: 94px minmax(0, 1fr); gap: 12px; } .wish-guide-stone:not(:has(> a)) { display: block; } .wish-guide-stone h3 { margin-top: 0; font-size: 15px; } .wish-guide-stone p { font-size: 12px; } .wish-guide-stone .text-link { font-size: 11px; } }
</style>

<script>
  import { matchesWishTags } from '../../lib/wish-filter';
  const filter = document.querySelector<HTMLElement>('.wish-filter')!;
  const buttons = [
    ...filter.querySelectorAll<HTMLButtonElement>('[data-wish-tag]'),
  ];
  const clear = filter.querySelector<HTMLButtonElement>('[data-clear-wishes]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-stone]')].map(
    (el) => ({ el, themes: JSON.parse(el.dataset.themes || '[]') as string[] }),
  );
  const selected = new Set<string>();
  const valid = new Set(buttons.map((b) => b.dataset.wishTag!));
  function restore() {
    selected.clear();
    for (const tag of new URLSearchParams(location.search).getAll('theme'))
      if (valid.has(tag)) selected.add(tag);
  }
  function render(updateUrl = true) {
    let count = 0;
    for (const card of cards) {
      card.el.hidden = !matchesWishTags(card.themes, [...selected]);
      if (!card.el.hidden) count++;
    }
    buttons.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(selected.has(button.dataset.wishTag!)),
      ),
    );
    clear.setAttribute('aria-pressed', String(selected.size === 0));
    document.querySelector('#wish-result-count')!.textContent =
      `${count}種類の天然石`;
    (document.querySelector('#wish-empty') as HTMLElement).hidden =
      count !== 0 || cards.length === 0;
    if (updateUrl) {
      const params = new URLSearchParams();
      selected.forEach((tag) => params.append('theme', tag));
      history.replaceState(
        null,
        '',
        location.pathname + (params.size ? '?' + params : ''),
      );
    }
  }
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const tag = button.dataset.wishTag!;
      if (selected.has(tag)) selected.delete(tag);
      else selected.add(tag);
      render();
    }),
  );
  clear.addEventListener('click', () => {
    selected.clear();
    render();
  });
  window.addEventListener('popstate', () => {
    restore();
    render(false);
  });
  restore();
  render(false);
  filter.hidden = false;
</script>
