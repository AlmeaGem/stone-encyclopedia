---
import Page from '../../layouts/Page.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { pathTo } from '../../lib/urls';

type FortuneService = {
  id: string;
  title: string;
  english: string;
  description: string;
  theme: string;
  href?: string;
};
const services: FortuneService[] = [
  { id: 'sanmei', title: '算命学', english: 'SANMEIGAKU', description: '生年月日から、持って生まれた資質や人生の流れを読み解く東洋の占術。', theme: '本質・才能・人生の流れ' },
  { id: 'four-pillars', title: '四柱推命', english: 'FOUR PILLARS OF DESTINY', description: '生まれた年月日時をもとに、性格や仕事、恋愛、運気の巡りを読み解きます。', theme: '性格・適性・恋愛・運勢' },
  { id: 'feng-shui', title: 'パワーストーン風水', english: 'GEMSTONE FENG SHUI', description: '方位や暮らしの空間に合わせて、天然石の選び方や飾り方を楽しむコンテンツ。', theme: '住まい・方位・石の配置' },
  { id: 'guardian', title: '守護石を調べる', english: 'GUARDIAN STONE', description: '生年月日の数字から、あなたに寄り添う守護石を探してみましょう。', theme: '生年月日・守護石', href: 'find-your-stone/' },
];
---
<Page title="占い・スピリチュアル" path="fortune/" description="算命学、四柱推命、パワーストーン風水、守護石。ALMÉA GEMの占い・スピリチュアルコンテンツ一覧。">
  <div class="wrap fortune-page">
    <Breadcrumbs items={[{name:'占い・スピリチュアル'}]} />
    <header class="fortune-intro">
      <p class="fortune-eyebrow">ALMÉA GEM · FORTUNE & GUIDANCE</p>
      <svg class="fortune-emblem" viewBox="0 0 64 64" fill="none" aria-hidden="true">
        <circle cx="32" cy="32" r="26" stroke="currentColor" stroke-width=".7" />
        <path d="M32 6v6M32 52v6M6 32h6M52 32h6M13.6 13.6l4 4M46.4 46.4l4 4M50.4 13.6l-4 4M17.6 46.4l-4 4" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        <path d="M32 15c2.6 10.3 6.7 14.4 17 17-10.3 2.6-14.4 6.7-17 17-2.6-10.3-6.7-14.4-17-17 10.3-2.6 14.4-6.7 17-17Z" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="32" cy="32" r="3" fill="currentColor"/>
      </svg>
      <h1>占い・スピリチュアル</h1>
      <p class="fortune-lead">自分を知る。<br class="fortune-mobile-break" />これからの道を見つめる。</p>
      <p>さまざまな占術と天然石の世界から、<br class="fortune-desktop-break" />今のあなたが気になるコンテンツをお選びください。</p>
    </header>
    <section class="fortune-selection" aria-labelledby="fortune-selection-title">
      <div class="fortune-heading">
        <p class="fortune-eyebrow">CHOOSE YOUR READING</p>
        <h2 id="fortune-selection-title">占い・スピリチュアル一覧</h2>
      </div>
      <div class="fortune-grid">
        {services.map((service) => (
          <article class:list={['fortune-card', service.id, {'is-ready': !!service.href}]}>
            <div class="fortune-card-top">
              <span class="fortune-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                  {service.id==='sanmei' && <><circle cx="24" cy="24" r="16"/><path d="M24 8c-11 0-11 16 0 16s11 16 0 16"/><circle cx="24" cy="16" r="2"/><circle cx="24" cy="32" r="2"/></>}
                  {service.id==='four-pillars' && <><path d="M8 11h32M8 37h32"/><rect x="10" y="15" width="5" height="18" rx="1"/><rect x="18" y="15" width="5" height="18" rx="1"/><rect x="26" y="15" width="5" height="18" rx="1"/><rect x="34" y="15" width="5" height="18" rx="1"/></>}
                  {service.id==='feng-shui' && <><circle cx="24" cy="24" r="17"/><path d="M24 4v6m0 28v6M4 24h6m28 0h6M24 13l6 11-6 11-6-11Z"/><path d="M18 24h12"/></>}
                  {service.id==='guardian' && <><path d="M24 7l13 5v10c0 10-6 15-13 19-7-4-13-9-13-19V12Z"/><path d="M24 15c1 5 3 7 8 8-5 1-7 3-8 8-1-5-3-7-8-8 5-1 7-3 8-8Z"/></>}
                </svg>
              </span>
              <span class="fortune-status">{service.href?'無料で利用可能':'準備中'}</span>
            </div>
            <p class="fortune-english">{service.english}</p>
            <h3>{service.title}</h3>
            <p class="fortune-theme">{service.theme}</p>
            <p class="fortune-description">{service.description}</p>
            {service.href ? <a class="fortune-action" href={pathTo(service.href)}>試してみる <span aria-hidden="true">→</span></a> : <p class="fortune-pending">COMING SOON</p>}
          </article>
        ))}
      </div>
      <p class="fortune-note">準備中のコンテンツの提供時期・料金は、公開時にご案内します。占いや天然石の象徴は自己理解のための参考情報であり、将来の結果を保証するものではありません。</p>
    </section>
    <div class="fortune-return"><a href={pathTo('premium/')}>体験型コンテンツ一覧へ →</a><a href={pathTo()}>ホームへ戻る</a></div>
  </div>
</Page>
<style>
  .fortune-page{max-width:1020px;padding-block:24px 64px;color:#4b3931}
  .fortune-intro{text-align:center;margin:20px auto 38px;padding:36px 20px 30px;max-width:850px;border:1px solid #d6b9a5;border-radius:14px;background:linear-gradient(115deg,transparent 20%,#fff8f0a6 48%,transparent 75%),linear-gradient(135deg,#ecd0bf,#faf6ef 60%,#e8c7b6);box-shadow:inset 0 0 0 1px #fff8ef,0 4px 14px #80523a12}
  .fortune-eyebrow{font:12px/1.6 Georgia,serif;letter-spacing:.15em;color:#795a48;margin:0 0 12px}
  .fortune-emblem{display:block;width:56px;height:56px;margin:0 auto 14px;color:#ac805b}
  .fortune-intro h1{font:500 clamp(24px,4vw,36px)/1.6 'Shippori Mincho',serif;color:#49362e;margin:0 0 12px}
  .fortune-intro p:not(.fortune-eyebrow){line-height:1.9;font-size:14px;margin:12px 0 0}
  .fortune-intro .fortune-lead{font:500 clamp(17px,2.7vw,22px)/1.8 'Shippori Mincho',serif!important}
  .fortune-mobile-break{display:none}
  .fortune-heading{text-align:center;margin:0 0 22px}
  .fortune-heading h2{font:500 clamp(20px,3vw,26px)/1.6 'Shippori Mincho',serif;margin:8px 0}
  .fortune-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .fortune-card{min-width:0;display:flex;flex-direction:column;align-items:flex-start;padding:24px;border:1px solid #dfcdbd;border-radius:12px;background:#fffcf8;box-shadow:0 3px 10px #60453308}
  .fortune-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;margin-bottom:18px}
  .fortune-icon{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#f4e8dc;border:1px solid #dfc5aa;color:#a77a50;flex:none}
  .fortune-icon svg{width:38px;height:38px}
  .fortune-status{font-size:12px;color:#6d584c;border:1px solid #d6bfab;border-radius:30px;padding:5px 10px;background:#fbf6f0}
  .fortune-card.is-ready .fortune-status{color:#48634b;background:#edf3ea;border-color:#b8ccb6}
  .fortune-english{font:11px/1.5 Georgia,serif;letter-spacing:.1em;color:#896d58;margin:0 0 5px}
  .fortune-card h3{font:500 24px/1.5 'Shippori Mincho',serif;margin:0;color:#49362e;overflow-wrap:anywhere}
  .fortune-theme{font-size:12px;color:#795a48;border-bottom:1px solid #e7d8cc;padding:8px 0;margin:0;width:100%}
  .fortune-description{font-size:14px;line-height:1.9;margin:12px 0 20px}
  .fortune-action,.fortune-pending{margin:auto 0 0;min-height:44px;width:100%;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:13px}
  .fortune-action{gap:12px;background:linear-gradient(110deg,#dcb29e,#efd5c6 54%,#deb5a1);border:1px solid #c59e86;color:#4b3027;text-decoration:none;box-shadow:inset 0 0 0 1px #fff8ec}
  .fortune-action:hover{border-color:#986e55}
  .fortune-action:focus-visible,.fortune-return a:focus-visible{outline:2px solid #91644e;outline-offset:3px}
  .fortune-pending{background:#f5f0ea;color:#79665a;font:11px Georgia,serif;letter-spacing:.12em}
  .fortune-note{font-size:12px;line-height:1.9;color:#76665f;margin:20px 0}
  .fortune-return{display:flex;flex-wrap:wrap;gap:20px;margin:26px 0;color:#80565e;font-size:13px}
  @media(max-width:640px){.fortune-page{padding-block:16px 40px}.fortune-intro{padding:24px 16px;margin:12px auto 28px}.fortune-mobile-break{display:block}.fortune-desktop-break{display:none}.fortune-grid{grid-template-columns:1fr;gap:12px}.fortune-card{padding:18px}.fortune-card h3{font-size:21px}.fortune-card-top{margin-bottom:12px}.fortune-description{margin:10px 0 16px}.fortune-return{gap:12px}}

/* Premium call-to-action polish */
.fortune-action{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:12px 15px;min-height:48px;box-sizing:border-box;border:1px solid #b88a72;border-radius:9px;background:linear-gradient(155deg,transparent 12%,#fff9ed9c 35%,transparent 55%),linear-gradient(110deg,#d9a58f,#f1d4c1 55%,#ddb09c);box-shadow:0 3px 0 #ae80685c,0 5px 12px #80523a20,inset 0 0 0 1px #fff7edb3;color:#4d3027;font-weight:600;text-decoration:none;line-height:1.5;font-size:15px;width:100%}.fortune-action:hover{filter:brightness(1.05)}.fortune-action span{font-size:20px}
</style>
