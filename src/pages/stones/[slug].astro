---
import Prose from '../../components/Prose.astro';
import ReportNudge from '../../components/ReportNudge.astro';
import { publicReferences, publicHandling } from '../../lib/references';
import Page from '../../layouts/Page.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import Visual from '../../components/Visual.astro';
import {
  stones,
  stoneById,
  kindLabels,
  unknown,
  articles,
  categories,
} from '../../lib/content';
import { pathTo, canonical } from '../../lib/urls';
export function getStaticPaths() {
  return stones.map((stone) => ({
    params: { slug: stone.slug },
    props: { stone },
  }));
}
const { stone } = Astro.props;
const references = publicReferences(stone.sources);
const related = stone.related.map(stoneById).filter(Boolean);
const synergies = (stone.synergyStoneIds || []).map(stoneById).filter(Boolean);
const cautions = (stone.cautionStoneIds || []).map(stoneById).filter(Boolean);
const reads = articles.filter((a) => a.stoneIds.includes(stone.id));
const sections = [
  ['鉱物・素材', stone.mineral],
  [
    stone.compositionHardness ? '組成・硬度' : 'モース硬度',
    stone.compositionHardness || stone.hardness,
  ],
  ['特徴', stone.characteristics],
  ['内包物・模様', stone.inclusions],
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${stone.name}の特徴・選び方・伝承`,
  description: stone.introduction,
  dateModified: stone.updatedAt,
  inLanguage: 'ja-JP',
  mainEntityOfPage: canonical(`stones/${stone.slug}/`),
  author: { '@type': 'Organization', name: 'ALMÉA GEM' },
  publisher: { '@type': 'Organization', name: 'ALMÉA GEM' },
  about: {
    '@type': 'Thing',
    name: stone.name,
    alternateName: [stone.english, ...stone.aliases],
  },
  isAccessibleForFree: true,
};
---

<Page
  title={`${stone.name}（${stone.english}）の特徴・意味・選び方`}
  path={`stones/${stone.slug}/`}
  description={`${stone.name}の鉱物・素材、組成・硬度、品質と選び方、歴史・伝承、象徴的な意味、組み合わせ、取り扱いを紹介します。`}
  schema={schema}
>
  <div class="wrap">
    <Breadcrumbs
      items={[{ name: '石を探す', path: 'stones/' }, { name: stone.name }]}
    />
    <section class="stone-heading">
      <div>
        <p class="eyebrow">STONE LIBRARY · {stone.id.toUpperCase()}</p>
        <span class="kind-label">
          {stone.classification || kindLabels[stone.kind]}
        </span>
        <h1>{stone.name}</h1>
        <p class="detail-english">{stone.english}</p>
        {stone.aliases.length > 0 && (
          <p class="aliases">
            別名・関連する流通名：{stone.aliases.join(' / ')}
          </p>
        )}
        <Prose text={stone.introduction} />
        <div class="tag-list">
          {stone.colors.map((c) => (
            <span>{c}</span>
          ))}
          {stone.themes.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </div>
      <Visual stone={stone} detail />
    </section>
    <div class="detail-layout">
      <aside class="detail-toc">
        <p class="eyebrow">ON THIS PAGE</p>
        <a href="#nature">鉱物・物理的な情報</a>
        <a href="#quality">品質・選び方</a>
        <a href="#story">伝説・スピリチュアルな意味</a>
        <a href="#pairing">意味と相性・おすすめの組み合わせ</a>
        <a href="#care">浄化・取り扱い</a>
        {references.length > 0 && <a href="#references">参考文献・出典</a>}
      </aside>
      <div class="detail-body">
        <section id="nature" class="detail-section">
          <p class="eyebrow">01 / NATURE</p>
          <h2>鉱物・物理的な情報</h2>
          <dl class="fact-list">
            {sections.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd class:list={{ unconfirmed: !value }}>{value || unknown}</dd>
              </div>
            ))}
            <div>
              <dt>色</dt>
              <dd>
                {stone.colors.length
                  ? stone.colors.join('・') +
                    '（検索用の代表色。個体により異なります）'
                  : unknown}
              </dd>
            </div>
            <div>
              <dt>産地・処理の確定</dt>
              <dd class="unconfirmed">
                未確認。個体ごとに販売表示や鑑別情報を確認してください。
              </dd>
            </div>
          </dl>
          {stone.kind === 'form' && (
            <p class="notice">
              これは結晶の形状に着目した項目です。独立した鉱物種としては扱っていません。
            </p>
          )}
        </section>
        <section id="quality" class="detail-section">
          <p class="eyebrow">02 / QUALITY</p>
          <h2>宝石としての見方・選び方</h2>
          <Prose text={stone.quality} />
          <h3>模造品・処理石を確認する</h3>
          <p>
            {stone.treatments ||
              '個別の見分け方は未確認です。色や写真だけで天然・合成・模造・処理の有無を断定できません。購入時に素材、処理表示、鑑別情報を確認してください。'}
          </p>
          <h3>選ぶときの視点</h3>
          <Prose text={stone.selection} />
          <h3>形状の違い</h3>
          <Prose text={stone.shapes} />
        </section>
        <section id="story" class="detail-section story-section">
          <p class="eyebrow">03 / SPIRITUAL MEANING</p>
          <h2>伝説と、スピリチュアルな意味</h2>
          <p class="quiet-note">
            ここで紹介する意味は、文化的な伝承や現代のクリスタル文化の解釈です。鉱物の性質とは分けてお読みください。
          </p>
          <h3>来歴・伝説・言い伝え</h3>
          {stone.legend ? (
            <Prose text={stone.legend} />
          ) : (
            <p class="quiet-note">
              この石ならではの伝承は調査中です。確認できたものから順次掲載します。
            </p>
          )}
          {stone.legendSourceUrl && (
            <p class="quiet-note">
              <a
                class="text-link"
                href={stone.legendSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                来歴・伝承の参考資料：{stone.legendSourceLabel || '出典を開く'}{' '}
                ↗
              </a>
            </p>
          )}
          <h3>スピリチュアルな意味・象徴</h3>
          <Prose text={stone.spiritualEffects || stone.symbolism} />
          <h3>こんな願いを持つ人に</h3>
          <div class="tag-list">
            {stone.wishes.map((id) => {
              const c = categories.find((x) => x.id === id);
              return c && <a href={pathTo(`wishes/${id}/`)}>{c.name} ↗</a>;
            })}
          </div>
        </section>
        <section id="pairing" class="detail-section">
          <p class="eyebrow">04 / STONE PAIRINGS</p>
          <h2>相性を考えた組み合わせ</h2>
          <p class="quiet-note">
            伝承の意味や色・質感を重ねたALMÉA GEMの提案です。
          </p>
          <h3>意味やテーマを重ねる石</h3>
          {stone.synergyNote && <Prose text={stone.synergyNote} />}
          {synergies.length > 0 ? (
            <div class="tag-list">
              {synergies.map(
                (s) =>
                  s && <a href={pathTo(`stones/${s.slug}/`)}>{s.name} ↗</a>,
              )}
            </div>
          ) : !stone.synergyNote ? (
            <p class="quiet-note">組み合わせの紹介を準備しています。</p>
          ) : null}
          {cautions.length > 0 && stone.cautionNote && (
            <>
              <h3>組み合わせを避けたい石</h3>
              <Prose text={stone.cautionNote} />
              <div class="tag-list">
                {cautions.map(
                  (s) =>
                    s && <a href={pathTo(`stones/${s.slug}/`)}>{s.name} ↗</a>,
                )}
              </div>
            </>
          )}
        </section>
        <section id="care" class="detail-section">
          <p class="eyebrow">05 / CARE</p>
          <h2>浄化と、取り扱いの注意</h2>
          <Prose text={stone.cleansing} />
          <div class="notice">{publicHandling(stone.handling)}</div>
          <a class="text-link" href={pathTo('articles/care/')}>
            お手入れの基本を読む ↗
          </a>
        </section>
        {references.length > 0 && (
          <section id="references" class="detail-section">
            <p class="eyebrow">06 / REFERENCES</p>
            <h2>参考文献・出典</h2>
            <ul class="source-list">
              {references.map((s) => (
                <li>
                  <strong>
                    {s.url ? (
                      <a href={s.url} target="_blank" rel="noopener noreferrer">
                        {s.label} ↗
                      </a>
                    ) : (
                      s.label
                    )}
                  </strong>
                  {s.note && <Prose text={s.note} />}
                  {s.checkedAt && <small>参照日：{s.checkedAt}</small>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    <section class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE MORE</p>
          <h2>あわせて知りたい石</h2>
        </div>
      </div>
      <p class="quiet-note">関連する伝承テーマの石をご紹介します。</p>
      <div class="stone-grid related-grid">
        {related.map((s) => s && <Card stone={s} />)}
      </div>
    </section>
    <section class="section">
      <h2>関連する基礎知識</h2>
      <div class="related-reads">
        {(reads.length ? reads : articles.slice(0, 2)).map((a) => (
          <a href={pathTo(`articles/${a.slug}/`)}>{a.title} ↗</a>
        ))}
      </div>
    </section>
    <ReportNudge kind="stone" />
  </div>
</Page>
