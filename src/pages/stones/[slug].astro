---
import ManuscriptBody from '../../components/ManuscriptBody.astro';
import LibraryControls from '../../components/LibraryControls.astro';
import LibraryScript from '../../components/LibraryScript.astro';
import { approvedManuscript } from '../../lib/approved-manuscripts';
import '../../manuscript-layout.css';
import ManuscriptHeading from '../../components/ManuscriptHeading.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Prose from '../../components/Prose.astro';
import ReportNudge from '../../components/ReportNudge.astro';
import { publicReferences, publicHandling } from '../../lib/references';
import { guidesForStone } from '../../lib/wish-guide';
import Page from '../../layouts/Page.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import Visual from '../../components/Visual.astro';
import StoneNavigation from '../../components/StoneNavigation.astro';
import {
  stones,
  stoneById,
  kindLabels,
  unknown,
  articles,
  categories,
} from '../../lib/content';
import { pathTo, canonical } from '../../lib/urls';
export function getStaticPaths() {
  return stones.map((stone) => ({
    params: { slug: stone.slug },
    props: { stone },
  }));
}
const { stone } = Astro.props;
const wishGuideNotes = guidesForStone(stone.id);
const manuscript = approvedManuscript(stone.id);
const storySections = manuscript.sections.filter(
  (s) =>
    s.kind !== 'pairings' &&
    !s.heading.startsWith('見どころ') &&
    !s.heading.startsWith('取り扱い'),
);
const pairSections = manuscript.sections.filter((s) => s.kind === 'pairings');
const qualitySections = manuscript.sections.filter((s) =>
  s.heading.startsWith('見どころ'),
);
const careSections = manuscript.sections.filter((s) =>
  s.heading.startsWith('取り扱い'),
);
const references = publicReferences(stone.sources);
const related = stone.related.map(stoneById).filter(Boolean);
const cautions = (stone.cautionStoneIds || []).map(stoneById).filter(Boolean);
const reads = articles.filter((a) => a.stoneIds.includes(stone.id));
const sections = [
  ['鉱物・素材', stone.mineral],
  [
    stone.compositionHardness ? '組成・硬度' : 'モース硬度',
    stone.compositionHardness || stone.hardness,
  ],
  ['特徴・色や模様', stone.characteristics],
  ['内包物・模様', stone.inclusions],
].filter(([, value]) => value?.trim());
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${stone.name}の特徴・選び方・伝承`,
  description: manuscript.catchphrase,
  dateModified: stone.updatedAt,
  inLanguage: 'ja-JP',
  mainEntityOfPage: canonical(`stones/${stone.slug}/`),
  author: { '@type': 'Organization', name: 'ALMÉA GEM' },
  publisher: { '@type': 'Organization', name: 'ALMÉA GEM' },
  about: {
    '@type': 'Thing',
    name: stone.name,
    alternateName: [stone.english, ...stone.aliases],
  },
  isAccessibleForFree: true,
};
---

<Page
  title={`${stone.name}（${stone.english}）の特徴・意味・選び方`}
  path={`stones/${stone.slug}/`}
  description={`${stone.name}の鉱物・素材、組成・硬度、品質と選び方、歴史・伝承、象徴的な意味、組み合わせ、取り扱いを紹介します。`}
  schema={schema}
  safeArea
>
  <LibraryScript />
  <div class="wrap">
    <Breadcrumbs
      items={[{ name: '石を探す', path: 'stones/' }, { name: stone.name }]}
    />
    <section class="stone-heading">
      <div>
        <p class="eyebrow">STONE LIBRARY</p>
        <span class="kind-label">
          {stone.classification || kindLabels[stone.kind]}
        </span>
        <h1>{stone.name}</h1>
        <p class="manuscript-catchphrase">{manuscript.catchphrase}</p>
        <LibraryControls id={stone.id} name={stone.name} />
        <p class="library-status" data-library-notice role="status" hidden></p>
        <a class="library-detail-link" href={pathTo('library/')}>
          My書架 ↗
        </a>
        <p class="detail-english">{stone.english}</p>
        {stone.aliases.length > 0 && (
          <p class="aliases">
            別名・関連する流通名：{stone.aliases.join(' / ')}
          </p>
        )}
        <div class="tag-list">
          {stone.colors.map((c) => (
            <span>{c}</span>
          ))}
          {stone.themes.map((t) => (
            <span>{t}</span>
          ))}
        </div>
      </div>
      <Visual stone={stone} detail />
    </section>
    <div class="detail-layout">
      <aside class="detail-toc">
        <p class="eyebrow">ON THIS PAGE</p>
        <a href="#story">物語・スピリチュアルな意味・願い</a>
        <a href="#pairing">相性のよい石</a>
        <a href="#quality">見どころ・選び方</a>
        <a href="#nature">鉱物・物理的な情報</a>
        <a href="#care">浄化・取り扱い</a>
        {references.length > 0 && <a href="#references">参考文献・出典</a>}
      </aside>
      <div class="detail-body">
        <div id="story" class="approved-story" data-manuscript-id={stone.id}>
          {wishGuideNotes.length > 0 && (
            <section class="detail-section manuscript-section">
              <SectionHeading>願いにまつわる象徴</SectionHeading>
              {wishGuideNotes.map((note) => (
                <p><a href={pathTo(`wishes/${note.category}/`)}>{note.title}</a>：{note.meaning}</p>
              ))}
              <p>石の意味は伝承や象徴として紹介しています。</p>
            </section>
          )}
          {storySections.map((section) =>
            section.subordinate ? (
              <section class="manuscript-subsection">
                <h3>
                  <ManuscriptHeading text={section.heading} />
                </h3>
                <ManuscriptBody section={section} />
              </section>
            ) : (
              <section class="detail-section manuscript-section">
                <SectionHeading>
                  <ManuscriptHeading text={section.heading} />
                </SectionHeading>
                <ManuscriptBody section={section} />
              </section>
            ),
          )}
          {stone.legendSourceUrl && (
            <p class="quiet-note">
              <a
                class="text-link"
                href={stone.legendSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                来歴・伝承の参考資料：{stone.legendSourceLabel || '出典を開く'}{' '}
                ↗
              </a>
            </p>
          )}
          <div class="tag-list">
            {stone.wishes.map((id) => (
              <a href={pathTo(`wishes/${id}/`)}>
                {categories.find((c) => c.id === id)?.name} ↗
              </a>
            ))}
          </div>
        </div>
        <section id="pairing" class="detail-section manuscript-section">
          {pairSections.map((section) => (
            <>
              <SectionHeading>
                <ManuscriptHeading text={section.heading} />
              </SectionHeading>
              <ManuscriptBody section={section} />
            </>
          ))}
          {cautions.length > 0 && stone.cautionNote && (
            <>
              <h3>組み合わせを避けたい石</h3>
              <Prose text={stone.cautionNote} />
              <div class="tag-list">
                {cautions.map(
                  (s) =>
                    s && <a href={pathTo(`stones/${s.slug}/`)}>{s.name} ↗</a>,
                )}
              </div>
            </>
          )}
        </section>
        <section id="quality" class="detail-section manuscript-section">
          {qualitySections.map((section) => (
            <>
              <SectionHeading>
                <ManuscriptHeading text={section.heading} />
              </SectionHeading>
              <ManuscriptBody section={section} />
            </>
          ))}
          <h3>模造品・処理石を確認する</h3>
          <p>
            {stone.treatments ||
              '色や写真だけで天然・合成・模造・処理の有無を断定できません。購入時には素材、処理表示、鑑別情報を確認してください。'}
          </p>
          <h3>形状の違い</h3>
          <Prose text={stone.shapes} />
        </section>
        <section id="nature" class="detail-section">
          <p class="eyebrow">01 / NATURE</p>
          <SectionHeading>鉱物・物理的な情報</SectionHeading>
          <dl class="fact-list">
            {sections.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd class:list={{ unconfirmed: !value }}>{value || unknown}</dd>
              </div>
            ))}
            {stone.colors.length > 0 && (
              <div>
                <dt>代表色</dt>
                <dd>{stone.colors.join('・')}（個体により異なります）</dd>
              </div>
            )}
            <div>
              <dt>個体の産地・処理</dt>
              <dd>
                個々の商品の産地や処理は、販売表示や鑑別情報でご確認ください。
              </dd>
            </div>
          </dl>
          {stone.kind === 'form' && (
            <p class="notice">
              これは結晶の形状に着目した項目です。独立した鉱物種としては扱っていません。
            </p>
          )}
        </section>
        <section id="care" class="detail-section">
          <p class="eyebrow">05 / CARE</p>
          <SectionHeading>浄化と、取り扱いの注意</SectionHeading>
          {careSections.map((section) => (
            <div class="manuscript-care">
              <h3>
                <ManuscriptHeading text={section.heading} />
              </h3>
              <ManuscriptBody section={section} />
            </div>
          ))}
          <Prose text={stone.cleansing} />
          <div class="notice">{publicHandling(stone.handling)}</div>
          <a class="text-link" href={pathTo('articles/care/')}>
            お手入れの基本を読む ↗
          </a>
        </section>
        {references.length > 0 && (
          <section id="references" class="detail-section">
            <p class="eyebrow">06 / REFERENCES</p>
            <SectionHeading>参考文献・出典</SectionHeading>
            <ul class="source-list">
              {references.map((s) => (
                <li>
                  <strong>
                    {s.url ? (
                      <a href={s.url} target="_blank" rel="noopener noreferrer">
                        {s.label} ↗
                      </a>
                    ) : (
                      s.label
                    )}
                  </strong>
                  {s.note && <Prose text={s.note} />}
                  {s.checkedAt && <small>参照日：{s.checkedAt}</small>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    <section class="section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE MORE</p>
          <h2>あわせて知りたい石</h2>
        </div>
      </div>
      <p class="quiet-note">関連する伝承テーマの石をご紹介します。</p>
      <div class="stone-grid related-grid">
        {related.map((s) => s && <Card stone={s} />)}
      </div>
    </section>
    <section class="section">
      <h2>関連する基礎知識</h2>
      <div class="related-reads">
        {(reads.length ? reads : articles.slice(0, 2)).map((a) => (
          <a href={pathTo(`articles/${a.slug}/`)}>{a.title} ↗</a>
        ))}
      </div>
    </section>
    <ReportNudge kind="stone" />
    <StoneNavigation stoneId={stone.id} />
  </div>
</Page>
