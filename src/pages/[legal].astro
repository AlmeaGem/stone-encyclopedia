---
import Prose from '../components/Prose.astro';
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pathTo } from '../lib/urls';
const pages = {
  about: {
    title: 'この図鑑について',
    intro: 'あなたの願いに寄り添う、パワーストーンとの出会いを。',
    sections: [
      [
        'ALMÉA GEMが届ける天然石図鑑',
        'パワーストーンブレスレットを手がけるALMÉA GEMが、石選びをもっと楽しむために届ける公開図鑑です。石の個性や伝承を知り、自分らしいブレスレットに想いを込めるきっかけに。210項目には、鉱物種だけでなく色・流通名・結晶形状の名称も含みます。',
      ],
      [
        '鉱物の情報と伝承について',
        '鉱物の性質、品質の見方、伝承上の意味を分けて紹介しています。確認できていない鉱物情報は断定せず、個体の性質や処理の有無は販売表示や鑑別情報でご確認ください。',
      ],
      [
        '写真と利用条件',
        '写真の撮影者や利用条件は、各写真のクレジットに記載します。実物写真がない項目の色のイメージは、実際の石の色や品質を示すものではありません。',
      ],
    ],
  },
  terms: {
    title: '利用規約',
    intro: '図鑑の利用について',
    sections: [
      [
        '情報の位置付け',
        '掲載情報は一般的な学習と選び方のための資料です。個体の鑑別、品質の保証、医療・投資などの専門的な助言ではありません。石の伝承は、結果や効能を保証するものではありません。',
      ],
      [
        '権利と利用',
        '本文、編集、デザイン等にはそれぞれの権利が適用されます。写真の利用条件は写真ごとに表示します。外部写真に当サイト独自の権利を主張するものではありません。',
      ],
      [
        '有料サービス',
        '現段階では有料サービスの購入契約や料金請求はありません。販売開始前に価格、提供条件、閲覧権限、返金条件、事業者情報を更新して表示します。',
      ],
      [
        '変更と適用',
        '掲載内容は必要に応じて更新します。無料図鑑のテーマ検索は一般的な情報を探す機能であり、個人向けのおすすめ順位や組み合わせを作成するものではありません。',
      ],
    ],
  },
  privacy: {
    title: 'プライバシーポリシー',
    intro: '必要な情報だけを、目的を明確に。',
    sections: [
      [
        '現在の情報の取り扱い',
        '現在、利用者登録、購入、カード情報の入力、診断回答のサーバー保存は行っていません。質問画面の選択は画面内だけに保持し、ページを閉じると消えます。広告・アクセス解析ツールは使用していません。',
      ],
      [
        '配信サービスのログ',
        'ホスティング事業者がIPアドレスやアクセス時刻などを運用上のログとして扱う場合があります。本サイトはGitHub Pagesで配信しています。サービスの変更時には、情報の取り扱いもお知らせします。',
      ],
      [
        '決済・お問い合わせについて',
        '決済・問い合わせの導入前に、取得項目、利用目的、委託先、保存期間、開示・削除の連絡先を明示します。現段階で入力欄を通じた個人情報の収集は行いません。',
      ],
      [
        '情報の送信について',
        '現在、お問い合わせフォームや決済画面から個人情報を送信する機能はありません。サービスを追加する場合は、このページで取り扱いをご案内します。',
      ],
    ],
  },
  commerce: {
    title: '特定商取引法に基づく表記',
    intro: '有料販売は開始していません。',
    sections: [
      [
        '販売状況',
        '現在は無料図鑑と質問画面の体験をご利用いただけます。個別選定レポート790円（税込・予定価格）は販売準備中です。注文・決済・料金の請求は行っていません。',
      ],
      [
        '販売事業者・提供条件',
        '販売開始時には、販売事業者、問い合わせ先、価格、追加料金、支払方法と時期、提供時期、返品・返金条件、動作環境をこのページに記載します。現在は購入できません。',
      ],
      [
        '購入前のご案内',
        '販売開始後は、購入前に表示される提供内容・利用条件・返品や返金の案内をご確認ください。',
      ],
    ],
  },
  refund: {
    title: '返金ポリシー',
    intro: '現段階では、料金は発生しません。',
    sections: [
      [
        '現在の取り扱い',
        '販売を開始していないため、購入・返金の受け付けはありません。質問画面を操作しても料金は発生しません。',
      ],
      [
        '返金条件のご案内',
        '販売開始時に、重複決済、未提供、障害、キャンセル・返金の条件と窓口をご案内します。現在は販売を行っていません。',
      ],
      [
        '購入前のご確認',
        '提供内容と返金条件は、購入前に確認できる形で表示します。',
      ],
    ],
  },
  contact: {
    title: 'お問い合わせ',
    intro: 'お問い合わせ窓口を準備しています。',
    sections: [
      [
        '現在の窓口',
        '現在、お問い合わせ受付は開始していません。このページから個人情報を送信することはできません。窓口の開設時にこちらでご案内します。',
      ],
      [
        'サービスについて',
        '図鑑は無料でご覧いただけます。個別選定レポートは販売準備中で、現在は注文や決済を受け付けていません。',
      ],
    ],
  },
};
export function getStaticPaths() {
  return ['about', 'terms', 'privacy', 'commerce', 'refund', 'contact'].map(
    (legal) => ({ params: { legal } }),
  );
}
const page = pages[Astro.params.legal as keyof typeof pages];
---

<Page
  title={page.title}
  path={`${Astro.params.legal}/`}
  description={page.intro}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: page.title }]} />
    <article class="reading">
      <p class="eyebrow">ALMÉA GEM / INFORMATION</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
      {page.sections.map(([h, b]) => (
        <section>
          <h2>{h}</h2>
          <Prose text={b} />
        </section>
      ))}
      <a class="text-link" href={pathTo('articles/editorial-policy/')}>
        詳しい編集方針 ↗
      </a>
    </article>
  </div>
</Page>
