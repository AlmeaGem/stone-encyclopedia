---
import Prose from '../components/Prose.astro';
import Page from '../layouts/Page.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pathTo } from '../lib/urls';
const pages = {
  about: {
    title: 'この図鑑について',
    intro: 'あなたの願いに寄り添う、パワーストーンとの出会いを。',
    sections: [
      [
        'ALMÉA GEMが届ける天然石図鑑',
        'パワーストーンブレスレットを手がけるALMÉA GEMが、石選びをもっと楽しむために届ける公開図鑑です。石の個性や伝承を知り、自分らしいブレスレットに想いを込めるきっかけに。210項目には、鉱物種だけでなく色・流通名・結晶形状の名称も含みます。既存の非公開業務管理サイトとは完全に別のサイトで、在庫・原価・仕入れ・顧客情報を掲載したり、その認証やAPIを利用したりしていません。',
      ],
      [
        '確認できたこと、できていないこと',
        '移行資料にない鉱物名や硬度、同定情報、書誌情報は未確認と表示しています。事実、宝石としての見方、伝承を分け、出典と確認日を追記できる設計にしています。現時点は確認用のプレビューです。',
      ],
      [
        '編集と写真',
        '書籍画像や長文をそのまま転載せず、短い編集メモに再構成しています。写真はライセンス・商用利用条件・石との一致を管理者が確認したものだけ掲載します。未登録の色イメージは写真ではありません。',
      ],
    ],
  },
  terms: {
    title: '利用規約',
    intro: 'プレビュー版の利用条件',
    sections: [
      [
        '情報の位置付け',
        '掲載情報は一般的な学習と選び方のための資料です。個体の鑑別、品質の保証、医療・投資などの専門的な助言ではありません。石の伝承は、結果や効能を保証するものではありません。',
      ],
      [
        '権利と利用',
        '本文、編集、デザイン等にはそれぞれの権利が適用されます。写真の利用条件は写真ごとに表示します。外部写真に当サイト独自の権利を主張するものではありません。',
      ],
      [
        '有料サービス',
        '現段階では有料サービスの購入契約や料金請求はありません。販売開始前に価格、提供条件、閲覧権限、返金条件、事業者情報を更新して表示します。',
      ],
      [
        '変更と適用',
        '公開内容の誤りや未確認の情報は、確認に応じて訂正します。この規約は2026年10月27日付のプレビュー用草案です。本番公開前に運営者が最終確認します。',
      ],
    ],
  },
  privacy: {
    title: 'プライバシーポリシー',
    intro: '必要な情報だけを、目的を明確に。',
    sections: [
      [
        '現在の情報の取り扱い',
        'このフェーズでは利用者登録、購入、カード情報の入力、診断回答のサーバー保存は行いません。質問画面の選択は画面内だけに保持し、ページを閉じると消えます。広告・解析スクリプトは初期状態で無効です。',
      ],
      [
        '配信サービスのログ',
        'ホスティング事業者がIPアドレスやアクセス時刻などを運用上のログとして扱う場合があります。プレビューはGitHub Pagesで配信しています。本番の配信・計測サービスが決まった段階で、その目的と利用条件を追記します。',
      ],
      [
        '将来の決済・問い合わせ',
        '決済・問い合わせの導入前に、取得項目、利用目的、委託先、保存期間、開示・削除の連絡先を明示します。現段階で入力欄を通じた個人情報の収集は行いません。',
      ],
      [
        '管理情報',
        '編集サーバーや写真候補の未承認データは公開ビルドへ含めません。既存のALMÉA Managerの非公開データを利用しません。2026年10月27日付の草案です。',
      ],
    ],
  },
  commerce: {
    title: '特定商取引法に基づく表記',
    intro: '有料販売は開始していません。',
    sections: [
      [
        '販売状況',
        '現在は無料図鑑と質問画面のプレビューです。購入ボタン、注文受付、決済は無効です。パーソナル天然石選定レポート790円（税込）は開発予定の商品であり、現時点で販売・請求は行っていません。',
      ],
      [
        '販売開始前に掲示する事項',
        '販売事業者名、運営責任者、住所、電話番号、問い合わせ先、販売価格、追加料金、支払方法と時期、提供時期、返品・返金条件、動作環境などを確認して掲示します。未確認の運営者情報を推測で埋めていません。',
      ],
      [
        '公開の条件',
        '上記の事業者表示と利用条件を整備し、決済・閲覧権限・返金対応をテストしてから有料販売を有効にします。',
      ],
    ],
  },
  refund: {
    title: '返金ポリシー',
    intro: '現段階では、料金は発生しません。',
    sections: [
      [
        '現在の取り扱い',
        '販売を開始していないため、購入・返金の受け付けはありません。質問画面を操作しても料金は発生しません。',
      ],
      [
        '販売開始に向けて',
        'デジタルレポートの提供条件、重複決済、未提供、障害、キャンセル・返金の窓口と期限を、決済実装後に定めます。現段階の文章を、販売時の最終的な返金条件とはしません。',
      ],
      [
        '販売前の確認',
        '購入前に見られる説明・サンプルと条件を用意し、問い合わせ窓口、決済事業者の返金手順を確認したうえで販売を開始します。',
      ],
    ],
  },
  contact: {
    title: 'お問い合わせ',
    intro: 'お問い合わせ窓口を準備しています。',
    sections: [
      [
        '現在の窓口',
        'プレビュー段階のため、一般のお問い合わせ受付はまだ開始していません。このページから情報を送信するフォームは設置していません。連絡先を確認する前に、個人のメールアドレスや住所を推測して公開することはしません。',
      ],
      [
        '公開前の対応',
        '運営者が公開用の連絡先と対応方針を確認し、プライバシーポリシーとあわせて更新します。有料販売は窓口の開設・確認後に開始します。',
      ],
    ],
  },
};
export function getStaticPaths() {
  return ['about', 'terms', 'privacy', 'commerce', 'refund', 'contact'].map(
    (legal) => ({ params: { legal } }),
  );
}
const page = pages[Astro.params.legal as keyof typeof pages];
---

<Page
  title={page.title}
  path={`${Astro.params.legal}/`}
  description={page.intro}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: page.title }]} />
    <article class="reading">
      <p class="eyebrow">ALMÉA GEM / INFORMATION</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
      {page.sections.map(([h, b]) => (
        <section>
          <h2>{h}</h2>
          <Prose text={b} />
        </section>
      ))}
      <a class="text-link" href={pathTo('articles/editorial-policy/')}>
        詳しい編集方針 ↗
      </a>
    </article>
  </div>
</Page>
