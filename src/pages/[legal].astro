export function getStaticPaths() {
  return ['about', 'terms', 'privacy', 'commerce', 'refund', 'contact'].map(
    (legal) => ({ params: { legal } }),
  );
}
const page = pages[Astro.params.legal as keyof typeof pages];
---

<Page
  title={page.title}
  path={`${Astro.params.legal}/`}
  description={page.intro}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: page.title }]} />
    <article class="reading">
      <p class="eyebrow">ALMÉA GEM / INFORMATION</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
      {page.sections.map(([heading, paragraphs]) => (
        <section>
          <h2>{heading}</h2>
          {paragraphs.map((paragraph) =>
            paragraph.includes('almeagem@gmail.com') ? (
              <p class="prose-lines">
                {paragraph.split('almeagem@gmail.com')[0]}
                <a href="mailto:almeagem@gmail.com">almeagem@gmail.com</a>
              </p>
            ) : (
              <Prose text={paragraph} />
            ),
          )}
        </section>
      ))}
    </article>
  </div>
</Page>
