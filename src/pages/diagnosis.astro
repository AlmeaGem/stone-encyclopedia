---
import Page from '../layouts/Page.astro';
import ReportOffer from '../components/ReportOffer.astro';
import ServiceComparison from '../components/ServiceComparison.astro';
import { reportFeatures, reportPrice } from '../lib/report-offer';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { categories } from '../lib/content';
import { pathTo } from '../lib/urls';
---

<Page
  title="パーソナル天然石選定レポート・質問画面"
  path="diagnosis/"
  description="願いと好みを整理する質問画面。パーソナル天然石選定レポート790円（税込・予定）は準備中です。現段階では決済・個人向け結果の提供はありません。"
>
  <div class="wrap narrow">
    <Breadcrumbs items={[{ name: '選定レポート' }]} />
    <div class="page-intro">
      <p class="eyebrow">PERSONAL STONE SELECTION</p>
      <h1>パーソナル天然石診断</h1>
      <p>質問に回答して、願望・好み・予算を整理できます。</p>
    </div>
    <section class="diagnosis-pricing" aria-label="回答前の料金案内">
      <p>
        <strong>
          質問への回答は無料です。個別の選定レポートの閲覧には790円（税込）が必要です。
        </strong>
      </p>
      <p>
        現在は販売準備中のため、料金の請求・個別の選定結果の提供はありません。
      </p>
      <p class="fine-print">
        回答はこの画面内だけに保持し、サーバーへ送信・保存しません。
      </p>
      <a class="sample-text-link" href={pathTo('sample-report/')}>
        固定の無料サンプルを見る ↗
      </a>
    </section>
    <noscript>
      <p class="notice">
        質問画面にはJavaScriptが必要です。無料図鑑はJavaScriptなしでも閲覧できます。
      </p>
    </noscript>
    <form id="questionnaire" class="questionnaire">
      <p id="step-label" class="eyebrow" aria-live="polite">
        STEP 1 / 6
      </p>
      <div class="step-progress" aria-hidden="true">
        <span id="progress"></span>
      </div>
      <fieldset data-step="1">
        <legend>どんなテーマが気になりますか？</legend>
        <div class="choice-grid">
          {categories.map((c) => (
            <label class="choice">
              <input type="radio" name="category" value={c.id} />
              <span>{c.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset data-step="2" hidden>
        <legend>メインの願いをひとつ。</legend>
        <div id="main-choices" class="choice-grid"></div>
      </fieldset>
      <fieldset data-step="3" hidden>
        <legend>サブの願いは、最大2つまで。</legend>
        <p>選ばずに進むこともできます。</p>
        <div class="choice-grid">
          {categories.map((c) => (
            <label class="choice">
              <input type="checkbox" name="sub" value={c.id} />
              <span>{c.name}</span>
            </label>
          ))}
        </div>
        <p id="sub-count" class="quiet-note">
          0 / 2 選択
        </p>
      </fieldset>
      <fieldset data-step="4" hidden>
        <legend>今の状況に近いものは？</legend>
        <div class="choice-grid">
          {[
            '新しい一歩を考えている',
            '変化の途中にいる',
            '日々を大切にしたい',
            'じっくり自分を見つめたい',
          ].map((s) => (
            <label class="choice">
              <input type="radio" name="situation" value={s} />
              <span>{s}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset data-step="5" hidden>
        <legend>見た目と、選び方の好み。</legend>
        <label>
          大切にしたいこと
          <select name="priority">
            <option value="">選択してください</option>
            {['伝承・象徴', '美しさ・色', '品質・表示の確かさ', 'バランス'].map(
              (s) => (
                <option>{s}</option>
              ),
            )}
          </select>
        </label>
        <label>
          好きな色や雰囲気
          <select name="color">
            <option value="">選択してください</option>
            {[
              '特に決めない',
              'ピンク・やわらかい',
              '青・すっきり',
              '緑・自然を感じる',
              '紫・落ち着き',
              '透明・軽やか',
              '黒・シック',
              '金・あたたかい',
            ].map((s) => (
              <option>{s}</option>
            ))}
          </select>
        </label>
        <label>
          石を選ぶ際の予算帯（レポート料金ではありません）
          <select name="budget">
            <option value="">選択してください</option>
            {[
              '未定',
              '3,000円未満',
              '3,000〜10,000円',
              '10,000〜30,000円',
              '30,000円以上',
            ].map((s) => (
              <option>{s}</option>
            ))}
          </select>
        </label>
      </fieldset>
      <fieldset data-step="6" hidden>
        <legend>回答が完了しました</legend>
        <div class="free-completion">
          <h2>無料で確認できること</h2>
          <ul>
            <li>願望の整理</li>
            <li>好み・予算の確認</li>
            <li>回答内容の確認</li>
          </ul>
        </div>
        <dl id="answers" class="fact-list"></dl>
        <div class="report-boundary">
          <p class="premium-badge">販売準備中</p>
          <h2>ここから先は有料です</h2>
          <p>パーソナル天然石選定レポート</p>
          <p class="report-price">{reportPrice}</p>
          <ul>
            {reportFeatures.map((feature) => (
              <li>{feature.title}</li>
            ))}
          </ul>
          <p>
            現在、個別の選定結果は提供していません。販売開始後に提供する予定の内容です。
          </p>
          <button type="button" class="button" disabled>
            購入・決済は準備中
          </button>
          <p>
            <a class="sample-text-link" href={pathTo('sample-report/')}>
              架空の回答による無料サンプルを見る ↗
            </a>
          </p>
        </div>
      </fieldset>
      <p id="question-error" class="form-error" role="alert"></p>
      <div class="wizard-actions">
        <button id="back" class="button outline" type="button" disabled>
          ← 戻る
        </button>
        <button id="next" class="button" type="button">
          次へ →
        </button>
      </div>
      <button id="clear-answers" class="text-link" type="reset">
        回答をすべて消す
      </button>
    </form>
    <div id="diagnosis-offer">
      <ReportOffer anchor />
    </div>
    <ServiceComparison />
  </div>
</Page>
<script>
  import { startQuestionnaire } from '../lib/questionnaire';
  startQuestionnaire();
</script>
